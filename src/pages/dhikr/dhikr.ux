<template>
  <scroll id="scroller" class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{title}}</text>

    <!-- Bands stack the text over the counter; wide screens put them side by side.
         Built only once the script is known: putting the Arabic image in place
         of the Latin text just after the page opened left the buttons below
         at the wrong place. -->
    <div if="{{ready && !finished}}" class="content {{w}}content {{r}}fit">
      <div class="text-col {{w}}text-col {{r}}col-text">
        <text class="step {{w}}step">{{step + 1}} / {{total}}</text>
        <div if="{{note}}" class="note {{w}}note">
          <text class="note-text {{w}}note-text">{{note}}</text>
        </div>
        <!-- Arabic is an image: the watch text engine cannot join the letters -->
        <image if="{{arabicImage}}" src="{{arabicImage}}" style="width: {{arabicWidth}}px; height: {{arabicHeight}}px;"></image>
        <text else class="latin {{w}}latin {{r}}col-text {{longText ? 'latin-long' : ''}} {{longText ? w + 'latin-long' : ''}}">{{latin}}</text>
        <text class="meaning {{w}}meaning {{r}}col-text">{{meaning}}</text>
      </div>

      <div class="action-col {{w}}action-col {{r}}col-action">
        <div class="circle {{w}}circle {{r}}circle" onclick="increment">
          <text class="count {{w}}count">{{count}}</text>
          <text class="target {{w}}target">/ {{target}}</text>
        </div>

        <div class="button button-main button-row {{w}}button {{w}}button-row {{r}}col-action" onclick="advance">
          <text class="button-text {{w}}button-text">{{t.next}}</text>
        </div>
        <div class="button button-row {{w}}button {{w}}button-row {{r}}col-action" onclick="back">
          <text class="button-text {{w}}button-text" style="color: {{step > 0 ? '#ffffff' : '#636366'}};">{{t.previous}}</text>
        </div>
        <div class="button button-row {{w}}button {{w}}button-row {{r}}col-action" onclick="restart">
          <text class="button-text {{w}}button-text">{{t.reset}}</text>
        </div>
      </div>
    </div>

    <div if="{{finished}}" class="content content-done {{r}}fit">
      <div class="circle circle-done {{w}}circle {{w}}circle-done" onclick="restart">
        <text class="count {{w}}count">✓</text>
      </div>
      <text class="done {{w}}done">{{t.done}}</text>
      <div class="button button-main button-wide {{w}}button {{w}}button-wide" onclick="restart">
        <text class="button-text {{w}}button-text">{{t.repeat}}</text>
      </div>
    </div>
  </scroll>
</template>

<script>
import vibrator from '@system.vibrator'
import PRAYER_DHIKR from '../../common/dhikr.js'
import { morningEveningDhikr } from '../../common/dhikrmorningevening.js'
import { STRINGS, loadLanguage, loadScript } from '../../common/i18n.js'
import ARABIC_IMAGES from '../../common/arabicimages.js'
import { keepScreenOn, loadLayout } from '../../common/screen.js'

// Which dhikr set to show, from the router param `set`
const SETS = {
  prayer: { steps: () => PRAYER_DHIKR, title: 'dhikr' },
  morning: { steps: () => morningEveningDhikr('morning'), title: 'dhikrMorning' },
  evening: { steps: () => morningEveningDhikr('evening'), title: 'dhikrEvening' }
}

export default {
  protected: {
    set: 'prayer'
  },

  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    lang: 'id',
    title: '',
    total: 0,
    step: 0,
    count: 0,
    target: 0,
    arabic: false,
    latin: '',
    arabicImage: '',
    arabicWidth: 0,
    arabicHeight: 0,
    meaning: '',
    note: '',
    longText: false,
    ready: false,
    finished: false
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
      // The Arabic image depends on the layout
      if (this.steps) this.render()
    })
    this.config = SETS[this.set] || SETS.prayer
    this.steps = this.config.steps()
    this.total = this.steps.length
    this.render()
    loadLanguage((lang) => {
      this.lang = lang
      this.t = STRINGS[lang]
      this.render()
    })
    loadScript((script) => {
      this.arabic = script === 'arabic'
      this.render()
      this.ready = true
    })
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  render() {
    const item = this.steps[this.step]
    this.title = this.t[this.config.title]
    this.target = item.count
    this.latin = item.latin
    this.meaning = item.meaning[this.lang]
    this.note = item.note ? item.note[this.lang] : ''
    this.longText = item.latin.length > 40
    // [band, narrow] images; falls back to Latin if the images are missing
    const images = this.arabic && ARABIC_IMAGES[item.arabic]
    const image = images ? images[this.w ? 1 : 0] : null
    this.arabicImage = image ? image[0] : ''
    this.arabicWidth = image ? image[1] : 0
    this.arabicHeight = image ? image[2] : 0
  },

  increment() {
    this.count += 1
    if (this.count >= this.target) {
      this.advance()
    } else {
      vibrator.vibrate({ mode: 'short' })
    }
  },

  // Move to the next step (also used to skip a step)
  advance() {
    vibrator.vibrate({ mode: 'long' })
    this.count = 0
    if (this.step + 1 >= this.steps.length) {
      this.finished = true
    } else {
      this.step += 1
      this.render()
    }
    this.scrollTop()
  },

  // Back to the previous step, starting its count again
  back() {
    if (this.step === 0) return
    this.step -= 1
    this.count = 0
    this.render()
    this.scrollTop()
  },

  restart() {
    this.step = 0
    this.count = 0
    this.finished = false
    this.render()
    this.scrollTop()
  },

  scrollTop() {
    const scroller = this.$element('scroller')
    if (scroller && scroller.scrollTo) scroller.scrollTo({ top: 0, behavior: 'instant' })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10px;
}

.content {
  flex-direction: column;
  align-items: center;
  width: 176px;
}

.text-col {
  flex-direction: column;
  align-items: center;
  width: 176px;
}

.action-col {
  flex-direction: column;
  align-items: center;
  width: 176px;
}

.step {
  font-size: 15px;
  color: #8e8e93;
  margin-bottom: 8px;
}

.note {
  padding: 3px 10px;
  margin-bottom: 8px;
  border-radius: 12px;
  background-color: #3a2a0a;
}

.note-text {
  font-size: 13px;
  color: #ffc56b;
}

.latin {
  width: 176px;
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.latin-long {
  font-size: 16px;
}

.meaning {
  width: 176px;
  font-size: 14px;
  color: #8e8e93;
  text-align: center;
  margin-top: 6px;
  margin-bottom: 14px;
}

.circle {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 140px;
  height: 140px;
  border-radius: 70px;
  border-width: 6px;
  border-color: #1fa77a;
  background-color: #0d3b2c;
  margin-bottom: 8px;
}

.circle-done {
  margin-top: 40px;
}

.count {
  font-size: 52px;
  font-weight: bold;
  color: #ffffff;
}

.target {
  font-size: 17px;
  color: #34d399;
}

.button {
  justify-content: center;
  align-items: center;
  width: 84px;
  height: 48px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.button-main {
  background-color: #145c44;
}

.button-row {
  width: 176px;
  margin-top: 8px;
}

.button-wide {
  width: 176px;
  margin-top: 16px;
}

.button-text {
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
}

.done {
  font-size: 22px;
  font-weight: bold;
  color: #34d399;
  margin-top: 14px;
}

/* Wide screens (Band 9 Pro): the dhikr text on the left, the counter and
   buttons on the right */
.w-page {
  height: 274px;
  padding: 8px 8px 12px 8px;
}

.w-title {
  font-size: 14px;
  margin-bottom: 6px;
}

.w-content {
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}

.w-text-col {
  width: 92px;
}

.w-step {
  font-size: 9px;
  margin-bottom: 4px;
}

.w-note {
  padding: 2px 6px;
  margin-bottom: 4px;
  border-radius: 8px;
}

.w-note-text {
  font-size: 8px;
}

.w-latin {
  width: 92px;
  font-size: 12px;
}

.w-latin-long {
  font-size: 10px;
}

.w-meaning {
  width: 92px;
  font-size: 9px;
  margin-top: 4px;
  margin-bottom: 0;
}

.w-action-col {
  width: 78px;
}

.w-circle {
  width: 72px;
  height: 72px;
  border-radius: 36px;
  border-width: 4px;
  margin-bottom: 4px;
}

.w-count {
  font-size: 26px;
}

.w-target {
  font-size: 9px;
}

.w-button {
  height: 26px;
  border-radius: 13px;
}

.w-button-row {
  width: 78px;
  margin-top: 4px;
}

.w-button-text {
  font-size: 8px;
}

.w-circle-done {
  margin-top: 16px;
}

.w-done {
  font-size: 14px;
  margin-top: 8px;
}

.w-button-wide {
  width: 120px;
  margin-top: 10px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}

.r-col-text {
  width: 88px;
}

.r-col-action {
  width: 66px;
}

.r-circle {
  width: 60px;
  height: 60px;
  border-radius: 30px;
}
</style>
