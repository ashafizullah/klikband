<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{title}}</text>
    <div class="group {{w}}group {{r}}fit">
      <div class="option {{w}}option" for="{{items}}" onclick="select($item.code)">
        <div class="text">
          <text class="name {{w}}name">{{$item.name}}</text>
          <text class="zone {{w}}zone">{{$item.zone}}</text>
        </div>
        <div class="radio {{$item.code === active ? 'radio-active ' + w + 'radio-active' : ''}} {{w}}radio"></div>
      </div>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import { CITIES, PHONE_CITY, zoneLabel, loadCity, saveCity, loadPhoneCity, saveCalcMethod } from '../../common/cities.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { loadLayout } from '../../common/screen.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    title: STRINGS.id.city,
    active: CITIES[0].name,
    items: CITIES.map((c) => ({ code: c.name, name: c.name, zone: zoneLabel(c) }))
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.title = this.t.city
      this.showPhone()
    })
    loadCity((city) => (this.active = city.custom ? PHONE_CITY : city.name))
  },

  // The place sent from the phone comes first, when there is one
  showPhone() {
    loadPhoneCity((place) => {
      this.phone = place
      const cities = CITIES.map((c) => ({ code: c.name, name: c.name, zone: zoneLabel(c) }))
      this.items = place
        ? [{ code: PHONE_CITY, name: place.name, zone: this.t.fromPhone + ' · ' + zoneLabel(place) }].concat(cities)
        : cities
    })
  },

  // Indonesian cities use the Kemenag method; the place from the phone, the
  // method sent with it
  select(code) {
    this.active = code
    saveCity(code)
    if (code !== PHONE_CITY) saveCalcMethod('kemenag')
    else if (this.phone && this.phone.phoneMethod) saveCalcMethod(this.phone.phoneMethod)
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
}

.group {
  flex-direction: column;
  width: 176px;
  padding: 4px 0;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.option {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 56px;
  padding: 0 16px;
}

.text {
  flex-direction: column;
}

.name {
  font-size: 17px;
  color: #ffffff;
}

.zone {
  font-size: 13px;
  color: #8e8e93;
}

.radio {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  border-width: 2px;
  border-color: #636366;
}

.radio-active {
  border-width: 6px;
  border-color: #1fa77a;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
  margin-bottom: 10px;
}

.w-group {
  padding: 2px 0;
  border-radius: 13px;
}

.w-option {
  height: 34px;
  padding: 0 10px;
}

.w-name {
  font-size: 10px;
}

.w-zone {
  font-size: 8px;
}

.w-radio {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  border-width: 1px;
}

.w-radio-active {
  border-width: 4px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
