<template>
  <scroll class="page" scroll-y="true">
    <text class="title">KlikBand</text>
    <div class="card" for="{{menu}}" onclick="openPage($item.uri)">
      <div class="icon" style="background-color: {{$item.color}};">
        <image class="icon-image" src="{{$item.icon}}"></image>
      </div>
      <marquee if="{{$item.long}}" id="m{{$idx}}" class="label" scrollamount="30" text-offset="40">{{$item.label}}</marquee>
      <text else class="label">{{$item.label}}</text>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { textWidth, startMarquees } from '../../common/text.js'

// Label area: 176 card - 28 padding - 52 icon - 12 gap
const LABEL_WIDTH = 84

// Add new categories here; `key` refers to STRINGS in common/i18n.js
const MENU = [
  { key: 'islam', color: '#1FA77A' },
  { key: 'settings', color: '#636366' },
  { key: 'about', color: '#FF9F0A' }
]

function buildMenu(lang) {
  const t = STRINGS[lang]
  return MENU.map((m) => ({
    label: t[m.key],
    long: textWidth(t[m.key], 22) > LABEL_WIDTH,
    icon: '/common/icons/' + m.key + '.png',
    color: m.color,
    uri: '/pages/' + m.key
  }))
}

export default {
  private: {
    menu: buildMenu('id')
  },

  onInit() {
    loadLanguage((lang) => (this.menu = buildMenu(lang)))
  },

  // Also runs when returning from Settings, so a language change shows up
  onShow() {
    loadLanguage((lang) => (this.menu = buildMenu(lang)))
  },

  onReady() {
    startMarquees(this, MENU.length)
  },

  openPage(uri) {
    router.push({ uri })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
}

.card {
  flex-direction: row;
  align-items: center;
  width: 176px;
  height: 88px;
  padding: 0 14px;
  margin-bottom: 10px;
  border-radius: 28px;
  background-color: #1c1c1e;
}

.icon {
  justify-content: center;
  align-items: center;
  width: 52px;
  height: 52px;
  border-radius: 26px;
  margin-right: 12px;
}

.icon-image {
  width: 30px;
  height: 30px;
}

.label {
  width: 84px;
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}
</style>
