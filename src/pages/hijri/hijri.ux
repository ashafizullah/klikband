<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{t.hijri}}</text>
    <div class="card {{w}}card {{r}}fit">
      <text class="weekday {{w}}weekday">{{weekday}}</text>
      <text class="day {{w}}day">{{day}}</text>
      <text class="month {{w}}month">{{month}}</text>
      <text class="year {{w}}year">{{year}} H</text>
    </div>
    <text class="gregorian {{w}}gregorian">{{gregorian}}</text>
    <div class="offset {{w}}offset {{r}}fit">
      <div class="button {{w}}button" onclick="shift(-1)">
        <text class="button-text {{w}}button-text">−</text>
      </div>
      <text class="offset-value {{w}}offset-value">{{offsetText}}</text>
      <div class="button {{w}}button" onclick="shift(1)">
        <text class="button-text {{w}}button-text">+</text>
      </div>
    </div>
    <text class="note {{w}}note {{r}}fit">{{t.hijriNote}}</text>
  </scroll>
</template>

<script>
import { toHijriWithOffset, loadHijriOffset, saveHijriOffset } from '../../common/hijri.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { loadLayout } from '../../common/screen.js'
import { loadAll } from '../../common/load.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    offset: 0,
    offsetText: '0 hari',
    weekday: '',
    day: '',
    month: '',
    year: '',
    gregorian: ''
  },

  onInit() {
    loadAll({ layout: loadLayout, lang: loadLanguage, offset: loadHijriOffset }, (v) => {
      this.w = v.layout[0]
      this.frame = v.layout[1]
      this.r = v.layout[2]
      this.t = STRINGS[v.lang]
      this.offset = v.offset
      this.render()
    })
  },

  shift(n) {
    this.offset = Math.max(-2, Math.min(2, this.offset + n))
    saveHijriOffset(this.offset)
    this.render()
  },

  render() {
    const now = new Date()
    const h = toHijriWithOffset(now, this.offset)
    const t = this.t
    this.weekday = t.weekdays[now.getDay()]
    this.day = String(h.day)
    this.month = t.hijriMonths[h.month - 1]
    this.year = String(h.year)
    this.gregorian = now.getDate() + ' ' + t.months[now.getMonth()] + ' ' + now.getFullYear()
    this.offsetText = (this.offset > 0 ? '+' : '') + this.offset + ' ' + t.day
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
}

.card {
  flex-direction: column;
  align-items: center;
  width: 176px;
  padding: 16px 8px 18px 8px;
  border-radius: 24px;
  background-color: #3a2a0a;
}

.weekday {
  font-size: 17px;
  color: #ffc56b;
}

.day {
  font-size: 72px;
  font-weight: bold;
  color: #ffffff;
}

.month {
  font-size: 20px;
  font-weight: bold;
  color: #ff9f0a;
  text-align: center;
}

.year {
  font-size: 17px;
  color: #ffffff;
  margin-top: 2px;
}

.gregorian {
  font-size: 16px;
  color: #8e8e93;
  margin-top: 12px;
  margin-bottom: 20px;
}

.offset {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 176px;
  padding: 6px;
  border-radius: 30px;
  background-color: #1c1c1e;
}

.button {
  justify-content: center;
  align-items: center;
  width: 48px;
  height: 48px;
  border-radius: 24px;
  background-color: #2c2c2e;
}

.button-text {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
}

.offset-value {
  font-size: 16px;
  color: #ffffff;
}

.note {
  font-size: 13px;
  color: #636366;
  text-align: center;
  margin-top: 10px;
  width: 168px;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
  margin-bottom: 10px;
}

.w-card {
  padding: 10px 5px 11px 5px;
  border-radius: 14px;
}

.w-weekday {
  font-size: 10px;
}

.w-day {
  font-size: 43px;
}

.w-month {
  font-size: 12px;
}

.w-year {
  font-size: 10px;
  margin-top: 1px;
}

.w-gregorian {
  font-size: 10px;
  margin-top: 7px;
  margin-bottom: 12px;
}

.w-offset {
  padding: 4px;
  border-radius: 18px;
}

.w-button {
  width: 29px;
  height: 29px;
  border-radius: 14px;
}

.w-button-text {
  font-size: 14px;
}

.w-offset-value {
  font-size: 10px;
}

.w-note {
  font-size: 8px;
  margin-top: 6px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
