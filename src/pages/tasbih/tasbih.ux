<template>
  <div class="page">
    <text class="title">{{t.tasbih}}</text>

    <!-- The middle section fills the remaining height, keeping the counter centered -->
    <div class="middle">
      <div class="circle" onclick="increment">
        <text class="count">{{count}}</text>
        <text class="target">/ {{target}}</text>
      </div>
      <div class="bar">
        <div class="bar-fill" style="width: {{barWidth}}px;"></div>
      </div>
      <text class="round">{{t.round}} {{round}}</text>
    </div>

    <!-- One full-width button per row, easier to tap on the band -->
    <div class="button" onclick="nextTarget">
      <text class="button-text">{{t.target}}</text>
    </div>
    <div class="button" onclick="reset">
      <text class="button-text">{{t.reset}}</text>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import storage from '@system.storage'
import { STRINGS, loadLanguage } from '../../common/i18n.js'

const TARGETS = [33, 99, 100]
const BAR_WIDTH = 140

export default {
  private: {
    t: STRINGS.id,
    count: 0,
    target: 33,
    round: 0,
    barWidth: 0
  },

  onInit() {
    loadLanguage((lang) => (this.t = STRINGS[lang]))
    storage.get({
      key: 'tasbih',
      success: (data) => {
        if (!data) return
        const s = JSON.parse(data)
        this.count = s.count
        this.target = s.target
        this.round = s.round
        this.updateBar()
      }
    })
  },

  save() {
    this.updateBar()
    storage.set({
      key: 'tasbih',
      value: JSON.stringify({ count: this.count, target: this.target, round: this.round })
    })
  },

  updateBar() {
    this.barWidth = Math.round((this.count / this.target) * BAR_WIDTH)
  },

  increment() {
    this.count += 1
    if (this.count >= this.target) {
      this.count = 0
      this.round += 1
      vibrator.vibrate({ mode: 'long' })
    } else {
      vibrator.vibrate({ mode: 'short' })
    }
    this.save()
  },

  nextTarget() {
    const i = TARGETS.indexOf(this.target)
    this.target = TARGETS[(i + 1) % TARGETS.length]
    this.reset()
  },

  reset() {
    this.count = 0
    this.round = 0
    this.save()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}

.middle {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 176px;
}

.circle {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 164px;
  height: 164px;
  border-radius: 82px;
  border-width: 6px;
  border-color: #3d7bff;
  background-color: #10203f;
}

.count {
  font-size: 60px;
  font-weight: bold;
  color: #ffffff;
}

.target {
  font-size: 18px;
  color: #8ab4ff;
}

.bar {
  width: 140px;
  height: 6px;
  margin-top: 20px;
  border-radius: 3px;
  background-color: #2c2c2e;
}

.bar-fill {
  height: 6px;
  border-radius: 3px;
  background-color: #3d7bff;
}

.round {
  font-size: 17px;
  color: #8e8e93;
  margin-top: 10px;
}

.button {
  justify-content: center;
  align-items: center;
  width: 176px;
  height: 48px;
  flex-shrink: 0;
  margin-top: 8px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.button-text {
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
}
</style>
