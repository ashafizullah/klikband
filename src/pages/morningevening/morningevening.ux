  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-bottom: 14px;
}

.cards {
  flex-direction: column;
}

.card {
  flex-direction: row;
  align-items: center;
  width: 176px;
  height: 96px;
  padding: 0 12px;
  margin-bottom: 10px;
  border-radius: 28px;
  background-color: #1c1c1e;
}

.card-suggested {
  background-color: #23234a;
}

.icon {
  justify-content: center;
  align-items: center;
  width: 44px;
  height: 44px;
  border-radius: 22px;
  margin-right: 10px;
}

.icon-morning {
  background-color: #ff9f0a;
}

.icon-evening {
  background-color: #5e5ce6;
}

.icon-image {
  width: 26px;
  height: 26px;
}

.text {
  flex-direction: column;
  width: 98px;
}

.label {
  font-size: 21px;
  font-weight: bold;
  color: #ffffff;
}

.time {
  font-size: 13px;
  color: #8e8e93;
}

/* Wide screens (Band 9 Pro): morning and evening as two tiles side by side */
.w-page {
  height: 274px;
  padding: 12px 8px 12px 8px;
}

.w-title {
  font-size: 14px;
  margin-bottom: 10px;
}

.w-cards {
  flex-direction: row;
  justify-content: space-between;
  width: 176px;
}

.w-card {
  flex-direction: column;
  justify-content: center;
  width: 85px;
  height: 120px;
  padding: 0 6px;
  margin-bottom: 0;
  border-radius: 16px;
}

.w-icon {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  margin-right: 0;
  margin-bottom: 6px;
}

.w-icon-image {
  width: 19px;
  height: 19px;
}

.w-text {
  align-items: center;
  width: 73px;
}

.w-label {
  font-size: 14px;
}

.w-time {
  font-size: 8px;
  text-align: center;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
