<template>
  <scroll id="scroller" class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title {{r}}fit">{{t.duas}}</text>
    <text class="step {{w}}step">{{index + 1}} / {{total}}</text>

    <!-- Built once the script is known, all at once: putting the Arabic image
         in place of the Latin text after the page opened misplaces what follows -->
    <div if="{{ready}}" class="content">
      <div class="card {{w}}card {{r}}fit">
        <!-- Arabic is an image: the watch text engine cannot join the letters -->
        <image if="{{arabicImage}}" class="arabic {{w}}arabic {{r}}arabic" src="{{arabicImage}}" style="width: {{arabicWidth}}px; height: {{arabicHeight}}px;"></image>
        <text else class="latin {{w}}latin">{{latin}}</text>
        <div class="divider {{w}}divider"></div>
        <text class="meaning {{w}}meaning">{{meaning}}</text>
        <text if="{{source}}" class="source {{w}}source">{{source}}</text>
      </div>

      <!-- One full-width button per row, easier to tap on the band -->
      <div class="button button-main {{w}}button {{r}}fit" onclick="go(1)">
        <text class="button-text {{w}}button-text" style="color: {{index < total - 1 ? '#ffffff' : '#636366'}};">{{t.next}}</text>
      </div>
      <div class="button {{w}}button {{r}}fit" onclick="go(-1)">
        <text class="button-text {{w}}button-text" style="color: {{index > 0 ? '#ffffff' : '#636366'}};">{{t.previous}}</text>
      </div>
    </div>
  </scroll>
</template>

<script>
import storage from '@system.storage'
import DUAS from '../../common/duas.js'
import { STRINGS, loadLanguage, loadScript } from '../../common/i18n.js'
import { DUAS as ARABIC_IMAGES } from '../../common/arabicduas.js'
import { keepScreenOn, loadLayout } from '../../common/screen.js'
import { loadAll } from '../../common/load.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    lang: 'id',
    index: 0,
    total: DUAS.length,
    arabic: false,
    ready: false,
    latin: '',
    arabicImage: '',
    arabicWidth: 0,
    arabicHeight: 0,
    meaning: '',
    source: ''
  },

  onInit() {
    // The Arabic image depends on the layout and the script
    loadAll(
      {
        layout: loadLayout,
        lang: loadLanguage,
        script: loadScript,
        // Reopen at the last dua read
        index: (cb) => storage.get({ key: 'duaIndex', success: cb, fail: () => cb('') })
      },
      (v) => {
        this.w = v.layout[0]
        this.frame = v.layout[1]
        this.r = v.layout[2]
        this.lang = v.lang
        this.t = STRINGS[v.lang]
        this.arabic = v.script === 'arabic'
        const i = parseInt(v.index, 10)
        if (i >= 0 && i < DUAS.length) this.index = i
        this.render()
        this.ready = true
      }
    )
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  render() {
    const dua = DUAS[this.index]
    const t = this.t
    this.latin = dua.latin
    // [band, narrow] images; falls back to Latin if the images are missing
    const images = this.arabic && ARABIC_IMAGES[dua.arabic]
    const image = images ? images[this.w ? 1 : 0] : null
    this.arabicImage = image ? image[0] : ''
    this.arabicWidth = image ? image[1] : 0
    this.arabicHeight = image ? image[2] : 0
    this.meaning = dua.meaning[this.lang]
    if (!dua.source) this.source = ''
    else if (t === STRINGS.zh) this.source = dua.source + ' ' + t.narrated
    else this.source = t.narrated + ' ' + dua.source
  },

  go(n) {
    const next = this.index + n
    if (next < 0 || next >= this.total) return
    this.index = next
    storage.set({ key: 'duaIndex', value: String(next) })
    this.render()
    const scroller = this.$element('scroller')
    if (scroller && scroller.scrollTo) scroller.scrollTo({ top: 0, behavior: 'instant' })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  width: 176px;
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.step {
  font-size: 14px;
  color: #ff6b6b;
  margin-bottom: 12px;
}

.content {
  flex-direction: column;
  align-items: center;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 14px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.latin {
  font-size: 17px;
  color: #ffffff;
}

.divider {
  height: 1px;
  margin: 10px 0;
  background-color: #2c2c2e;
}

.meaning {
  font-size: 14px;
  color: #8e8e93;
}

.source {
  font-size: 13px;
  color: #ff6b6b;
  margin-top: 8px;
}

.button {
  justify-content: center;
  align-items: center;
  width: 176px;
  height: 48px;
  margin-bottom: 8px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.button-main {
  background-color: #5c1f1f;
}

.button-text {
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
}

.w-step {
  font-size: 8px;
  margin-bottom: 7px;
}

.w-card {
  padding: 8px;
  margin-bottom: 5px;
  border-radius: 13px;
}

/* The wide card is 160 px inside, the image 144: center it. Round cards
   are 144 px inside already */
.w-arabic {
  margin-left: 8px;
}

.r-arabic {
  margin-left: 0;
}

.w-latin {
  font-size: 10px;
}

.w-divider {
  margin: 6px 0;
}

.w-meaning {
  font-size: 8px;
}

.w-source {
  font-size: 8px;
  margin-top: 5px;
}

.w-button {
  height: 29px;
  margin-bottom: 5px;
  border-radius: 14px;
}

.w-button-text {
  font-size: 10px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
