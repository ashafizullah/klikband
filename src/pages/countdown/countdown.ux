<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{t.countdown}}</text>

    <text if="{{items.length === 0}}" class="empty {{w}}empty">{{t.empty}}</text>

    <div class="card {{w}}card {{r}}fit" for="{{items}}" onclick="edit($item.index)">
      <text class="label {{w}}label">{{$item.label}}</text>
      <text class="date {{w}}date">{{$item.date}}</text>
      <text class="days {{$item.past ? 'days-past' : ''}} {{w}}days">{{$item.days}}</text>
    </div>

    <div if="{{canAdd}}" class="button {{w}}button {{r}}fit" onclick="edit(-1)">
      <text class="button-text {{w}}button-text">+ {{t.add}}</text>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import { loadCountdowns, daysUntil, targetDate, MAX_ENTRIES } from '../../common/countdown.js'
import { STRINGS, loadLanguage, formatDays, formatFullDate } from '../../common/i18n.js'
import { loadLayout } from '../../common/screen.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    items: [],
    canAdd: true
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    this.list = []
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.render()
    })
  },

  // Also runs when returning from the editor
  onShow() {
    loadCountdowns((list) => {
      this.list = list
      this.render()
    })
  },

  render() {
    const t = this.t
    const today = new Date()
    // Nearest upcoming first, then past dates
    this.items = this.list
      .map((entry, index) => {
        const days = daysUntil(entry, today)
        return {
          index,
          sortKey: days >= 0 ? days : 100000 - days,
          label: t.labels[entry.label] + (entry.repeat !== 'none' ? ' · ' + t.repeats[entry.repeat] : ''),
          date: formatFullDate(t, targetDate(entry, today)),
          days: formatDays(t, days),
          past: days < 0
        }
      })
      .sort((a, b) => a.sortKey - b.sortKey)
    this.canAdd = this.list.length < MAX_ENTRIES
  },

  edit(index) {
    router.push({ uri: '/pages/countdownedit', params: { index } })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
}

.empty {
  font-size: 16px;
  color: #8e8e93;
  margin: 20px 0;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 12px 14px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.label {
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
}

.date {
  font-size: 14px;
  color: #8e8e93;
}

.days {
  font-size: 24px;
  font-weight: bold;
  color: #ff9f0a;
  margin-top: 4px;
}

.days-past {
  color: #636366;
}

.button {
  justify-content: center;
  align-items: center;
  width: 176px;
  height: 52px;
  margin-top: 4px;
  border-radius: 26px;
  background-color: #3a2a0a;
}

.button-text {
  font-size: 18px;
  font-weight: bold;
  color: #ff9f0a;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
  margin-bottom: 10px;
}

.w-empty {
  font-size: 10px;
  margin: 12px 0;
}

.w-card {
  padding: 7px 8px;
  margin-bottom: 5px;
  border-radius: 13px;
}

.w-label {
  font-size: 10px;
}

.w-date {
  font-size: 8px;
}

.w-days {
  font-size: 14px;
  margin-top: 2px;
}

.w-button {
  height: 31px;
  margin-top: 2px;
  border-radius: 16px;
}

.w-button-text {
  font-size: 11px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
