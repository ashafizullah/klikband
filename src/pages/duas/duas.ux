<template>
  <scroll id="scroller" class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title {{r}}fit">{{t.duas}}</text>
    <text class="step {{w}}step">{{index + 1}} / {{total}}</text>

    <div class="card {{w}}card {{r}}fit">
      <text class="latin {{w}}latin">{{latin}}</text>
      <div class="divider {{w}}divider"></div>
      <text class="meaning {{w}}meaning">{{meaning}}</text>
      <text if="{{source}}" class="source {{w}}source">{{source}}</text>
    </div>

    <!-- One full-width button per row, easier to tap on the band -->
    <div class="button button-main {{w}}button {{r}}fit" onclick="go(1)">
      <text class="button-text {{w}}button-text" style="color: {{index < total - 1 ? '#ffffff' : '#636366'}};">{{t.next}}</text>
    </div>
    <div class="button {{w}}button {{r}}fit" onclick="go(-1)">
      <text class="button-text {{w}}button-text" style="color: {{index > 0 ? '#ffffff' : '#636366'}};">{{t.previous}}</text>
    </div>
    <text class="note {{w}}note {{r}}fit">{{t.source}}: Almanhaj.or.id</text>
  </scroll>
</template>

<script>
import storage from '@system.storage'
import DUAS from '../../common/duas.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { keepScreenOn, loadLayout } from '../../common/screen.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    lang: 'id',
    index: 0,
    total: DUAS.length,
    latin: '',
    meaning: '',
    source: ''
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    this.render()
    loadLanguage((lang) => {
      this.lang = lang
      this.t = STRINGS[lang]
      this.render()
    })
    // Reopen at the last dua read
    storage.get({
      key: 'duaIndex',
      success: (data) => {
        const i = parseInt(data, 10)
        if (i >= 0 && i < DUAS.length) {
          this.index = i
          this.render()
        }
      }
    })
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  render() {
    const dua = DUAS[this.index]
    const t = this.t
    this.latin = dua.latin
    this.meaning = dua.meaning[this.lang]
    if (!dua.source) this.source = ''
    else if (t === STRINGS.zh) this.source = dua.source + ' ' + t.narrated
    else this.source = t.narrated + ' ' + dua.source
  },

  go(n) {
    const next = this.index + n
    if (next < 0 || next >= this.total) return
    this.index = next
    storage.set({ key: 'duaIndex', value: String(next) })
    this.render()
    const scroller = this.$element('scroller')
    if (scroller && scroller.scrollTo) scroller.scrollTo({ top: 0, behavior: 'instant' })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  width: 176px;
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.step {
  font-size: 14px;
  color: #ff6b6b;
  margin-bottom: 12px;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 14px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.latin {
  font-size: 17px;
  color: #ffffff;
}

.divider {
  height: 1px;
  margin: 10px 0;
  background-color: #2c2c2e;
}

.meaning {
  font-size: 14px;
  color: #8e8e93;
}

.source {
  font-size: 13px;
  color: #ff6b6b;
  margin-top: 8px;
}

.button {
  justify-content: center;
  align-items: center;
  width: 176px;
  height: 48px;
  margin-bottom: 8px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.button-main {
  background-color: #5c1f1f;
}

.button-text {
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
}

.note {
  width: 168px;
  font-size: 13px;
  color: #636366;
  text-align: center;
  margin-top: 4px;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
}

.w-step {
  font-size: 8px;
  margin-bottom: 7px;
}

.w-card {
  padding: 8px;
  margin-bottom: 5px;
  border-radius: 13px;
}

.w-latin {
  font-size: 10px;
}

.w-divider {
  margin: 6px 0;
}

.w-meaning {
  font-size: 8px;
}

.w-source {
  font-size: 8px;
  margin-top: 5px;
}

.w-button {
  height: 29px;
  margin-bottom: 5px;
  border-radius: 14px;
}

.w-button-text {
  font-size: 10px;
}

.w-note {
  font-size: 8px;
  margin-top: 2px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
