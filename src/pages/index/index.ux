<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">KlikBand</text>
    <div class="grid {{w}}grid {{r}}fit">
      <div class="card {{w}}card {{r}}card" for="{{menu}}" onclick="openPage($item.uri)">
        <div class="icon {{w}}icon" style="background-color: {{$item.color}};">
          <image class="icon-image {{w}}icon-image" src="{{$item.icon}}"></image>
        </div>
        <text class="label {{w}}label {{r}}label">{{$item.label}}</text>
      </div>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { loadLayout } from '../../common/screen.js'

// Add new categories here; `key` refers to STRINGS in common/i18n.js
const MENU = [
  { key: 'clock', color: '#5E5CE6' },
  { key: 'islam', color: '#1FA77A' },
  { key: 'general', color: '#0A84FF' },
  { key: 'settings', color: '#636366' },
  { key: 'about', color: '#FF9F0A' }
]

function buildMenu(lang) {
  const t = STRINGS[lang]
  return MENU.map((m) => ({
    label: t[m.key],
    icon: '/common/icons/' + m.key + '.png',
    color: m.color,
    uri: '/pages/' + m.key
  }))
}

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    menu: buildMenu('id')
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    loadLanguage((lang) => this.apply(lang))
  },

  // Also runs when returning from Settings, so a language change shows up
  onShow() {
    loadLanguage((lang) => this.apply(lang))
  },

  apply(lang) {
    this.menu = buildMenu(lang)
  },

  openPage(uri) {
    router.push({ uri })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 32px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12px;
}

.grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 176px;
}

.card {
  flex-direction: row;
  align-items: center;
  width: 176px;
  height: 64px;
  padding: 0 10px;
  margin-bottom: 8px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.icon {
  justify-content: center;
  align-items: center;
  width: 38px;
  height: 38px;
  border-radius: 19px;
  margin-right: 10px;
}

.icon-image {
  width: 24px;
  height: 24px;
}

/* Long names wrap to a second line instead of scrolling */
.label {
  width: 108px;
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
  lines: 2;
  text-overflow: ellipsis;
}

/* Wide screens (Band 9 Pro): a two-column grid of tiles */
.w-page {
  height: 274px;
  padding: 10px 6px 12px 6px;
}

.w-title {
  font-size: 14px;
  margin-bottom: 6px;
}

.w-grid {
  width: 180px;
}

.w-card {
  flex-direction: column;
  justify-content: center;
  width: 87px;
  height: 64px;
  padding: 0 6px;
  margin-bottom: 6px;
  border-radius: 14px;
}

.w-icon {
  width: 26px;
  height: 26px;
  border-radius: 13px;
  margin-right: 0;
  margin-bottom: 4px;
}

.w-icon-image {
  width: 16px;
  height: 16px;
}

.w-label {
  width: 75px;
  font-size: 10px;
  text-align: center;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}

.r-card {
  width: 78px;
}

.r-label {
  width: 68px;
}
</style>
