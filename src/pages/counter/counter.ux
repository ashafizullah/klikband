<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <!-- The whole name pill is the tap target: each tap picks the next preset label -->
    <div class="name {{w}}name {{r}}fit" onclick="rename">
      <text class="title {{w}}title">{{label}}</text>
      <text class="name-hint {{w}}name-hint">{{t.tapToRename}}</text>
    </div>

    <div class="circle {{w}}circle" onclick="increment">
      <text class="count" style="font-size: {{countSize}}px;">{{count}}</text>
    </div>

    <!-- One full-width button per row, easier to tap on the band -->
    <div class="button {{w}}button {{r}}fit" onclick="undo">
      <text class="button-text {{w}}button-text" style="color: {{count > 0 ? '#ffffff' : '#636366'}};">−1</text>
    </div>
    <!-- Inline colors: a changing class broke button sizes on the band -->
    <div class="button {{w}}button {{r}}fit" style="background-color: {{confirming === 'reset' ? '#ff453a' : '#1c1c1e'}};" onclick="reset">
      <text class="button-text {{w}}button-text">{{confirming === 'reset' ? t.sure : t.reset}}</text>
    </div>
    <div class="button {{w}}button {{r}}fit" style="background-color: {{confirming === 'remove' ? '#ff453a' : '#1c1c1e'}};" onclick="remove">
      <text class="button-text {{w}}button-text" style="color: {{confirming === 'remove' ? '#ffffff' : '#ff453a'}};">{{confirming === 'remove' ? t.sure : t.remove}}</text>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { COUNTER_LABELS, loadCounters, saveCounters } from '../../common/counters.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { keepScreenOn, loadLayout } from '../../common/screen.js'

// Reset and delete need a second tap within this time
const CONFIRM_MS = 3000

export default {
  // Index of the counter (router params arrive as strings)
  protected: {
    index: 0
  },

  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    label: '',
    count: 0,
    countSize: 56,
    confirming: ''
  },

  onInit() {
    this.index = parseInt(this.index, 10)
    this.list = []
    this.entry = { label: 'other', count: 0 }
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
      this.render()
    })
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.render()
    }, this)
    loadCounters((list) => {
      this.list = list
      if (list[this.index]) this.entry = list[this.index]
      this.render()
    })
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  onDestroy() {
    clearTimeout(this.confirmTimer)
  },

  render() {
    this.label = this.t.counterLabels[this.entry.label]
    this.count = this.entry.count
    // Smaller digits as the number grows, so it stays inside the circle
    const digits = String(this.count).length
    const size = digits <= 3 ? 56 : digits === 4 ? 46 : digits === 5 ? 38 : 30
    this.countSize = this.w ? Math.round(size * 0.6) : size
  },

  save() {
    this.list[this.index] = this.entry
    saveCounters(this.list)
    this.render()
  },

  increment() {
    this.entry.count += 1
    vibrator.vibrate({ mode: 'short' })
    this.save()
  },

  undo() {
    if (this.entry.count === 0) return
    this.entry.count -= 1
    this.save()
  },

  rename() {
    const i = COUNTER_LABELS.indexOf(this.entry.label)
    this.entry.label = COUNTER_LABELS[(i + 1) % COUNTER_LABELS.length]
    this.save()
  },

  // First tap asks "Sure?", a second tap within CONFIRM_MS does it
  confirm(action) {
    if (this.confirming !== action) {
      clearTimeout(this.confirmTimer)
      this.confirming = action
      this.confirmTimer = setTimeout(() => (this.confirming = ''), CONFIRM_MS)
      return false
    }
    clearTimeout(this.confirmTimer)
    this.confirming = ''
    return true
  },

  reset() {
    if (!this.confirm('reset')) return
    this.entry.count = 0
    this.save()
  },

  remove() {
    if (!this.confirm('remove')) return
    this.list.splice(this.index, 1)
    saveCounters(this.list)
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.name {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 176px;
  height: 56px;
  margin-bottom: 12px;
  border-radius: 28px;
  background-color: #1c1c1e;
}

.name-hint {
  font-size: 12px;
  color: #8e8e93;
}

.title {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.circle {
  justify-content: center;
  align-items: center;
  width: 164px;
  height: 164px;
  margin-bottom: 14px;
  border-radius: 82px;
  border-width: 6px;
  border-color: #bf5af2;
  background-color: #2e1a3d;
}

.count {
  font-weight: bold;
  color: #ffffff;
}

.button {
  justify-content: center;
  align-items: center;
  width: 176px;
  height: 48px;
  margin-bottom: 8px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.button-text {
  width: 176px;
  text-align: center;
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-name {
  height: 34px;
  margin-bottom: 7px;
  border-radius: 17px;
}

.w-name-hint {
  font-size: 7px;
}

.w-title {
  font-size: 12px;
}

.w-circle {
  width: 98px;
  height: 98px;
  margin-bottom: 8px;
  border-radius: 49px;
  border-width: 4px;
}

.w-button {
  height: 29px;
  margin-bottom: 5px;
  border-radius: 14px;
}

.w-button-text {
  font-size: 10px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
