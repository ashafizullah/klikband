<template>
  <scroll class="page" scroll-y="true">
    <text class="lokasi">{{lokasi}}</text>
    <text class="tanggal">{{tanggal}}</text>

    <div class="berikut">
      <text class="berikut-label">{{berikutLabel}}</text>
      <text class="berikut-jam">{{berikutJam}}</text>
      <text class="hitung-mundur">{{hitungMundur}}</text>
    </div>

    <div class="baris {{item.aktif ? 'baris-aktif' : ''}}" for="{{daftar}}">
      <text class="nama">{{item.label}}</text>
      <text class="jam">{{item.jam}}</text>
    </div>
  </scroll>
</template>

<script>
import { URUTAN, hitungJadwal, formatMenit } from '../../common/prayer.js'
import { TEKS, muatBahasa, formatTanggal } from '../../common/i18n.js'

export default {
  private: {
    lokasi: '',
    tanggal: '',
    berikutLabel: '',
    berikutJam: '',
    hitungMundur: '',
    daftar: []
  },

  onInit() {
    this.t = TEKS.id
    this.perbarui()
    muatBahasa((kode) => {
      this.t = TEKS[kode]
      this.perbarui()
    })
    this.timer = setInterval(() => this.perbarui(), 30 * 1000)
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  perbarui() {
    const t = this.t
    const now = new Date()
    const menitSekarang = now.getHours() * 60 + now.getMinutes()
    const jadwal = hitungJadwal(now)

    // Waktu sholat berikutnya; setelah Isya, lanjut ke Subuh besok
    let berikut = URUTAN.find((k) => k !== 'terbit' && jadwal[k] > menitSekarang)
    let menitBerikut
    if (berikut) {
      menitBerikut = jadwal[berikut]
    } else {
      berikut = 'subuh'
      const besok = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1)
      menitBerikut = hitungJadwal(besok).subuh + 24 * 60
    }

    const sisa = menitBerikut - menitSekarang
    this.lokasi = t.lokasi
    this.tanggal = formatTanggal(t, now)
    this.berikutLabel = t.waktu[berikut]
    this.berikutJam = formatMenit(menitBerikut)
    this.hitungMundur = '-' + Math.floor(sisa / 60) + t.jam + ' ' + (sisa % 60) + t.menit
    this.daftar = URUTAN.map((k) => ({
      label: t.waktu[k],
      jam: formatMenit(jadwal[k]),
      aktif: k === berikut
    }))
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 24px 12px;
  background-color: #000000;
}

.lokasi {
  font-size: 18px;
  color: #8a8a8a;
}

.tanggal {
  font-size: 20px;
  color: #ffffff;
  margin-bottom: 12px;
}

.berikut {
  flex-direction: column;
  align-items: center;
  width: 168px;
  padding: 10px 0;
  margin-bottom: 12px;
  border-radius: 16px;
  background-color: #0f3d2e;
}

.berikut-label {
  font-size: 20px;
  color: #7ee2b8;
}

.berikut-jam {
  font-size: 44px;
  color: #ffffff;
}

.hitung-mundur {
  font-size: 18px;
  color: #7ee2b8;
}

.baris {
  flex-direction: row;
  justify-content: space-between;
  width: 168px;
  height: 40px;
  padding: 0 10px;
  border-radius: 10px;
}

.baris-aktif {
  background-color: #1f1f1f;
}

.nama {
  font-size: 20px;
  color: #cccccc;
}

.jam {
  font-size: 20px;
  color: #ffffff;
}
</style>
