<template>
  <scroll id="scroller" class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="step {{w}}step">{{index + 1}} / {{total}}</text>
    <text class="title {{w}}title {{r}}fit">{{title}}</text>

    <div class="card {{w}}card {{r}}fit">
      <div class="point {{w}}point" for="{{points}}">
        <text class="bullet {{w}}bullet">•</text>
        <text class="point-text {{w}}point-text">{{$item}}</text>
      </div>
    </div>

    <div class="card {{w}}card {{r}}fit" for="{{readings}}">
      <text class="latin {{w}}latin">{{$item.latin}}</text>
      <div class="divider {{w}}divider"></div>
      <text class="meaning {{w}}meaning">{{$item.meaning}}</text>
    </div>

    <div if="{{counter}}" class="button button-main button-wide {{w}}button {{w}}button-wide" onclick="openCounter">
      <text class="button-text {{w}}button-text">{{t.countRounds}}</text>
    </div>

    <!-- One full-width button per row, easier to tap on the band -->
    <div class="button button-wide {{w}}button {{w}}button-wide" onclick="go(1)">
      <text class="button-text {{w}}button-text" style="color: {{index < total - 1 ? '#ffffff' : '#636366'}};">{{t.next}}</text>
    </div>
    <div class="button button-wide {{w}}button {{w}}button-wide" onclick="go(-1)">
      <text class="button-text {{w}}button-text" style="color: {{index > 0 ? '#ffffff' : '#636366'}};">{{t.previous}}</text>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import { UMRAH_STEPS } from '../../common/umrah.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { keepScreenOn, loadLayout } from '../../common/screen.js'

export default {
  // Step to show (router params arrive as strings)
  protected: {
    index: 0
  },

  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    lang: 'id',
    total: UMRAH_STEPS.length,
    title: '',
    points: [],
    readings: [],
    counter: ''
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    this.index = parseInt(this.index, 10) || 0
    this.render()
    loadLanguage((lang) => {
      this.lang = lang
      this.t = STRINGS[lang]
      this.render()
    })
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  render() {
    const step = UMRAH_STEPS[this.index]
    const lang = this.lang
    this.title = step.title[lang]
    this.points = step.points[lang]
    this.readings = (step.readings || []).map((r) => ({ latin: r.latin, meaning: r.meaning[lang] }))
    this.counter = step.counter || ''
  },

  go(n) {
    const next = this.index + n
    if (next < 0 || next >= this.total) return
    this.index = next
    this.render()
    const scroller = this.$element('scroller')
    if (scroller && scroller.scrollTo) scroller.scrollTo({ top: 0, behavior: 'instant' })
  },

  openCounter() {
    router.push({ uri: '/pages/umrahcount', params: { type: this.counter } })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.step {
  font-size: 14px;
  color: #30d158;
}

.title {
  width: 176px;
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-bottom: 12px;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 14px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.point {
  flex-direction: row;
  margin-bottom: 6px;
}

.bullet {
  width: 12px;
  font-size: 15px;
  color: #30d158;
}

.point-text {
  width: 136px;
  font-size: 15px;
  color: #ffffff;
}

.latin {
  font-size: 17px;
  color: #ffffff;
}

.divider {
  height: 1px;
  margin: 10px 0;
  background-color: #2c2c2e;
}

.meaning {
  font-size: 14px;
  color: #8e8e93;
}

.button {
  justify-content: center;
  align-items: center;
  width: 84px;
  height: 48px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.button-main {
  background-color: #1f4d33;
}

.button-wide {
  width: 176px;
  margin-bottom: 8px;
}

.button-text {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-step {
  font-size: 8px;
}

.w-title {
  font-size: 13px;
  margin-bottom: 7px;
}

.w-card {
  padding: 8px;
  margin-bottom: 5px;
  border-radius: 13px;
}

.w-point {
  margin-bottom: 4px;
}

.w-bullet {
  font-size: 9px;
}

.w-point-text {
  font-size: 9px;
}

.w-latin {
  font-size: 10px;
}

.w-divider {
  margin: 6px 0;
}

.w-meaning {
  font-size: 8px;
}

.w-button {
  height: 29px;
  border-radius: 14px;
}

.w-button-wide {
  margin-bottom: 5px;
}

.w-button-text {
  font-size: 11px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
