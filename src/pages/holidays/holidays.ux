<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{t.holidays}}</text>
    <div class="card {{$idx === 0 ? 'card-next' : ''}} {{w}}card {{r}}fit" for="{{items}}">
      <text class="name {{w}}name">{{$item.name}}</text>
      <text class="hijri {{w}}hijri">{{$item.hijri}}</text>
      <text class="date {{w}}date">{{$item.date}}</text>
      <text class="days {{w}}days">{{$item.days}}</text>
    </div>
    <text class="note {{w}}note {{r}}fit">{{t.hijriNote}}</text>
  </scroll>
</template>

<script>
import { upcomingHolidays } from '../../common/holidays.js'
import { loadHijriOffset } from '../../common/hijri.js'
import { STRINGS, knownLanguage, loadLanguage, formatDays, formatFullDate } from '../../common/i18n.js'
import { loadLayout } from '../../common/screen.js'
import { loadAll } from '../../common/load.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    items: []
  },

  onInit() {
    this.t = STRINGS[knownLanguage(this)]
    this.offset = 0
    loadAll({ layout: loadLayout, lang: (cb) => loadLanguage(cb, this), offset: loadHijriOffset }, (v) => {
      this.w = v.layout[0]
      this.frame = v.layout[1]
      this.r = v.layout[2]
      this.t = STRINGS[v.lang]
      this.offset = v.offset
      this.render()
    })
  },

  render() {
    const t = this.t
    this.items = upcomingHolidays(new Date(), this.offset).map((h) => ({
      name: t.holidayNames[h.key],
      hijri: h.hijri.day + ' ' + t.hijriMonths[h.hijri.month - 1] + ' ' + h.hijri.year + ' H',
      date: formatFullDate(t, h.date),
      days: formatDays(t, h.days)
    }))
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-bottom: 16px;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 12px 14px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.card-next {
  background-color: #4a1424;
}

.name {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
}

.hijri {
  font-size: 14px;
  color: #ff9f0a;
}

.date {
  font-size: 14px;
  color: #8e8e93;
}

.days {
  font-size: 22px;
  font-weight: bold;
  color: #ff6b8a;
  margin-top: 4px;
}

.note {
  width: 168px;
  font-size: 13px;
  color: #636366;
  text-align: center;
  margin-top: 4px;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
  margin-bottom: 10px;
}

.w-card {
  padding: 7px 8px;
  margin-bottom: 5px;
  border-radius: 13px;
}

.w-name {
  font-size: 11px;
}

.w-hijri {
  font-size: 8px;
}

.w-date {
  font-size: 8px;
}

.w-days {
  font-size: 13px;
  margin-top: 2px;
}

.w-note {
  font-size: 8px;
  margin-top: 2px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
