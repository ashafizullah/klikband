<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <image class="logo {{w}}logo" src="/common/logo.png"></image>
    <text class="name {{w}}name">KlikBand</text>
    <text class="version {{w}}version">{{t.version}} {{version}}</text>

    <div class="card {{w}}card {{r}}fit">
      <text class="description {{w}}description">{{t.description}}</text>
    </div>

    <div class="card {{w}}card {{r}}fit">
      <text class="heading {{w}}heading">{{t.sources}}</text>
      <div class="source" for="{{sources}}">
        <div if="{{$idx > 0}}" class="divider {{w}}divider"></div>
        <text class="label {{w}}label">{{$item.name}}</text>
        <text class="value {{w}}value">{{$item.source}}</text>
      </div>
    </div>

    <div class="card {{w}}card {{r}}fit">
      <text class="label {{w}}label">GitHub</text>
      <text class="value {{w}}value">ashafizullah/klikband</text>
      <div class="divider {{w}}divider"></div>
      <text class="label {{w}}label">{{t.license}}</text>
      <text class="value {{w}}value">MIT</text>
    </div>

    <div class="card {{w}}card {{r}}fit">
      <text class="label {{w}}label">{{t.storage}}</text>
      <text class="value {{w}}value">{{storageUsed}}</text>
      <div class="bar {{w}}bar">
        <div class="bar-fill {{w}}bar-fill" style="width: {{storageBar}}px;"></div>
      </div>
      <text class="detail {{w}}detail">{{storageDetail}}</text>
    </div>

    <!-- Only where the battery API exists (not on Smart Band 9 / 9 Pro) -->
    <div class="card {{w}}card {{r}}fit" if="{{batteryLevel}}">
      <text class="label {{w}}label">{{t.battery}}</text>
      <text class="value {{w}}value">{{batteryLevel}}</text>
      <text class="detail {{w}}detail">{{batteryState}}</text>
    </div>

    <div class="card {{w}}card {{r}}fit">
      <text class="label {{w}}label">{{t.model}}</text>
      <text class="value {{w}}value">{{model}}</text>
      <div class="divider {{w}}divider"></div>
      <text class="label {{w}}label">{{t.system}}</text>
      <text class="value {{w}}value">{{system}}</text>
      <div class="divider {{w}}divider"></div>
      <text class="label {{w}}label">{{t.platform}}</text>
      <text class="value {{w}}value">{{platform}}</text>
      <div class="divider {{w}}divider"></div>
      <text class="label {{w}}label">{{t.screen}}</text>
      <text class="value {{w}}value">{{screen}}</text>
    </div>
  </scroll>
</template>

<script>
import app from '@system.app'
import device from '@system.device'
import battery from '@system.battery'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { loadLayout } from '../../common/screen.js'

// Inner width of the card: 176 - 2 * 14 padding
const BAR_WIDTH = 148

// Where the texts and calculations come from, shown on About
function buildSources(t) {
  const almanhaj = 'almanhaj.or.id'
  return [
    { name: t.dhikr, source: almanhaj },
    { name: t.morningevening, source: almanhaj },
    { name: t.duas, source: almanhaj },
    { name: t.umrah, source: almanhaj },
    { name: t.prayer, source: t.sourcePrayer },
    { name: t.hijri, source: t.sourceHijri }
  ]
}

// 31457280 -> "30.0 MB", 2147483648 -> "2.0 GB"
function formatBytes(bytes) {
  const mb = bytes / (1024 * 1024)
  return mb >= 1024 ? (mb / 1024).toFixed(1) + ' GB' : mb.toFixed(1) + ' MB'
}

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    sources: buildSources(STRINGS.id),
    version: '',
    storageUsed: '-',
    storageBar: 0,
    storageDetail: '',
    batteryLevel: '',
    batteryState: '',
    model: '-',
    system: '-',
    platform: '-',
    screen: '-'
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.sources = buildSources(this.t)
      this.refresh()
    })
    this.refresh()
    try {
      this.version = app.getInfo().versionName
    } catch (e) {
      this.version = '-'
    }
  },

  // Each API is optional on some devices, so every call fails quietly to "-"
  refresh() {
    const t = this.t
    try {
      device.getInfo({
        success: (info) => {
          this.model = [info.brand, info.model].filter(Boolean).join(' ') || '-'
          this.system = [info.osType, info.osVersionName].filter(Boolean).join(' ') || '-'
          this.platform = info.platformVersionName
            ? info.platformVersionName + ' (' + info.platformVersionCode + ')'
            : String(info.platformVersionCode || '-')
          this.screen = info.screenWidth + ' × ' + info.screenHeight + (info.deviceType ? ' · ' + info.deviceType : '')
        }
      })
    } catch (e) {}

    try {
      device.getTotalStorage({
        success: (total) => {
          device.getAvailableStorage({
            success: (available) => {
              const all = total.totalStorage
              const free = available.availableStorage
              const used = Math.max(0, all - free)
              this.storageUsed = formatBytes(used) + ' / ' + formatBytes(all)
              this.storageBar = all > 0 ? Math.round((used / all) * BAR_WIDTH) : 0
              this.storageDetail = formatBytes(free) + ' ' + t.storageFree
            }
          })
        }
      })
    } catch (e) {}

    try {
      battery.getStatus({
        success: (status) => {
          this.batteryLevel = Math.round(status.level * 100) + '%'
          this.batteryState = status.charging ? t.charging : t.notCharging
        }
      })
    } catch (e) {}
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.logo {
  width: 72px;
  height: 72px;
  margin-bottom: 10px;
}

.name {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
}

.version {
  font-size: 15px;
  color: #8e8e93;
  margin-bottom: 16px;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 14px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.description {
  font-size: 15px;
  color: #ffffff;
}

.heading {
  font-size: 15px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8px;
}

.source {
  flex-direction: column;
}

.label {
  font-size: 13px;
  color: #8e8e93;
}

.value {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
}

.detail {
  font-size: 13px;
  color: #8e8e93;
  margin-top: 2px;
}

.bar {
  width: 148px;
  height: 6px;
  margin-top: 8px;
  border-radius: 3px;
  background-color: #2c2c2e;
}

.bar-fill {
  height: 6px;
  border-radius: 3px;
  background-color: #30b0c7;
}

.divider {
  height: 1px;
  margin: 10px 0;
  background-color: #2c2c2e;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-logo {
  width: 43px;
  height: 43px;
  margin-bottom: 6px;
}

.w-name {
  font-size: 14px;
}

.w-version {
  font-size: 9px;
  margin-bottom: 10px;
}

.w-card {
  padding: 8px;
  margin-bottom: 5px;
  border-radius: 13px;
}

.w-description {
  font-size: 9px;
}

.w-heading {
  font-size: 10px;
  margin-bottom: 5px;
}

.w-label {
  font-size: 8px;
}

.w-value {
  font-size: 10px;
}

.w-detail {
  font-size: 8px;
  margin-top: 1px;
}

.w-bar {
  height: 4px;
  margin-top: 5px;
  border-radius: 2px;
}

.w-bar-fill {
  height: 4px;
  border-radius: 2px;
}

.w-divider {
  margin: 6px 0;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
