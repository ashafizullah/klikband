<template>
  <div class="page {{w}}page" style="{{frame}}">
    <text class="title {{w}}title">{{t.morningevening}}</text>
    <div class="cards {{w}}cards {{r}}fit">
      <div class="card {{w}}card {{suggested === 'morning' ? 'card-suggested' : ''}}" onclick="openSet('morning')">
        <div class="icon {{w}}icon icon-morning">
          <image class="icon-image {{w}}icon-image" src="/common/icons/today.png"></image>
        </div>
        <div class="text {{w}}text">
          <text class="label {{w}}label">{{t.morning}}</text>
          <text class="time {{w}}time">{{t.morningTime}}</text>
        </div>
      </div>
      <div class="card {{w}}card {{suggested === 'evening' ? 'card-suggested' : ''}}" onclick="openSet('evening')">
        <div class="icon {{w}}icon icon-evening">
          <image class="icon-image {{w}}icon-image" src="/common/icons/islam.png"></image>
        </div>
        <div class="text {{w}}text">
          <text class="label {{w}}label">{{t.evening}}</text>
          <text class="time {{w}}time">{{t.eveningTime}}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { loadLayout } from '../../common/screen.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    // Highlight evening from noon onwards, morning otherwise
    suggested: new Date().getHours() >= 12 ? 'evening' : 'morning'
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    loadLanguage((lang) => (this.t = STRINGS[lang]), this)
  },

  openSet(set) {
    router.push({ uri: '/pages/dhikr', params: { set } })
  }
}
</script>

