<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{t.umrah}}</text>
    <div class="card {{w}}card {{r}}fit" for="{{items}}" onclick="open($idx)">
      <div class="number {{w}}number">
        <text class="number-text {{w}}number-text">{{$idx + 1}}</text>
      </div>
      <text class="label {{w}}label">{{$item}}</text>
    </div>
    <text class="note {{w}}note {{r}}fit">{{t.source}}: Almanhaj.or.id</text>
  </scroll>
</template>

<script>
import router from '@system.router'
import { UMRAH_STEPS } from '../../common/umrah.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { loadLayout } from '../../common/screen.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    t: STRINGS.id,
    items: UMRAH_STEPS.map((s) => s.title.id)
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.items = UMRAH_STEPS.map((s) => s.title[lang])
    }, this)
  },

  open(index) {
    router.push({ uri: '/pages/umrahstep', params: { index } })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-bottom: 16px;
}

.card {
  flex-direction: row;
  align-items: center;
  width: 176px;
  min-height: 60px;
  padding: 10px 12px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.number {
  justify-content: center;
  align-items: center;
  width: 32px;
  height: 32px;
  border-radius: 16px;
  margin-right: 10px;
  background-color: #2c4a3a;
}

.number-text {
  font-size: 15px;
  font-weight: bold;
  color: #30d158;
}

.label {
  width: 110px;
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
}

.note {
  width: 168px;
  font-size: 13px;
  color: #636366;
  text-align: center;
  margin-top: 4px;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
  margin-bottom: 10px;
}

.w-card {
  min-height: 36px;
  padding: 6px 7px;
  margin-bottom: 5px;
  border-radius: 13px;
}

.w-number {
  width: 19px;
  height: 19px;
  border-radius: 10px;
  margin-right: 6px;
}

.w-number-text {
  font-size: 9px;
}

.w-label {
  font-size: 10px;
}

.w-note {
  font-size: 8px;
  margin-top: 2px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
