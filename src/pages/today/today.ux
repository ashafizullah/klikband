  color: #ffffff;
}

.tile-month {
  width: 72px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
  color: #ffffff;
  lines: 2;
}

.hijri-day {
  color: #ff9f0a;
}

.hijri-month {
  color: #ff9f0a;
}

.hero {
  flex-direction: column;
  align-items: center;
  width: 176px;
  padding: 14px 0 14px 0;
  margin-bottom: 8px;
  border-radius: 24px;
  background-color: #0d3b2c;
}

.hero-main {
  flex-direction: column;
  align-items: center;
}

.hero-label {
  font-size: 18px;
  font-weight: bold;
  color: #34d399;
}

.hero-time {
  font-size: 48px;
  font-weight: bold;
  color: #ffffff;
}

.hero-side {
  flex-direction: column;
  align-items: center;
}

.pill {
  padding: 4px 12px;
  border-radius: 14px;
  background-color: #145c44;
}

.pill-text {
  font-size: 15px;
  color: #ffffff;
}

.city {
  font-size: 13px;
  color: #8ee6c0;
  margin-top: 8px;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 14px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.section {
  font-size: 15px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8px;
}

.when {
  font-size: 13px;
  color: #8e8e93;
}

.fast {
  font-size: 16px;
  font-weight: bold;
  color: #34d399;
}

.fast-none {
  font-weight: normal;
  color: #636366;
}

.fast-forbidden {
  color: #ff6b6b;
}

.divider {
  height: 1px;
  margin: 8px 0;
  background-color: #2c2c2e;
}

/* Wide screens (Band 9 Pro): smaller type, and the next prayer card lays out
   side by side */
.w-page {
  height: 274px;
  padding: 10px 8px 12px 8px;
}

.w-title {
  font-size: 14px;
  margin-bottom: 6px;
}

.w-dates {
  margin-bottom: 6px;
}

.w-tile {
  width: 86px;
  padding: 6px 4px;
