  margin-bottom: 12px;
}

.panels {
  flex-direction: column;
}

.hero {
  flex-direction: column;
  align-items: center;
  width: 176px;
  padding: 14px 0 16px 0;
  margin-bottom: 8px;
  border-radius: 24px;
  background-color: #0d3b2c;
}

.hero-label {
  font-size: 18px;
  font-weight: bold;
  color: #34d399;
}

.hero-time {
  font-size: 52px;
  font-weight: bold;
  color: #ffffff;
}

.pill {
  padding: 4px 12px;
  border-radius: 14px;
  background-color: #145c44;
}

.pill-text {
  font-size: 15px;
  color: #ffffff;
}

.list {
  flex-direction: column;
  width: 176px;
  padding: 6px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 42px;
  padding: 0 12px;
  border-radius: 16px;
}

.row-next {
  background-color: #0d3b2c;
}

.name {
  font-size: 18px;
  color: #ffffff;
}

.time {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
}

.text-next {
  color: #34d399;
}

.text-past {
  color: #636366;
}

/* Wide screens (Band 9 Pro): the next prayer and the full schedule side by side */
.w-page {
  height: 274px;
  padding: 8px 8px 10px 8px;
}

.w-title {
  font-size: 14px;
}

.w-subtitle {
  font-size: 9px;
  margin-top: 0;
}

.w-subtitle-last {
  margin-bottom: 6px;
}

.w-panels {
  flex-direction: row;
  justify-content: space-between;
  width: 176px;
}

.w-hero {
  justify-content: center;
  width: 74px;
  padding: 8px 0;
  margin-bottom: 0;
  border-radius: 14px;
}

.w-hero-label {
  font-size: 11px;
}

.w-hero-time {
  font-size: 22px;
}

.w-pill {
  padding: 2px 5px;
  border-radius: 8px;
}

.w-pill-text {
  font-size: 7px;
}

.w-list {
  width: 98px;
  padding: 4px;
  border-radius: 14px;
}

.w-row {
  height: 22px;
  padding: 0 7px;
  border-radius: 9px;
}

.w-cell {
  font-size: 10px;
}
</style>
