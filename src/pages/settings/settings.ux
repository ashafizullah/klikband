<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{title}}</text>

    <text class="section {{w}}section {{r}}fit">{{cityLabel}}</text>
    <div class="group {{w}}group {{r}}fit">
      <div class="option {{w}}option" onclick="openCities">
        <text class="option-label {{w}}option-label">{{cityName}}</text>
        <text class="chevron {{w}}chevron">›</text>
      </div>
    </div>

    <text class="section section-next {{w}}section {{w}}section-next {{r}}fit">{{calcMethodLabel}}</text>
    <div class="group {{w}}group {{r}}fit">
      <div class="option {{w}}option" for="{{calcMethods}}" onclick="selectCalcMethod($item.code)">
        <text class="option-label {{w}}option-label">{{$item.label}}</text>
        <div class="radio {{$item.code === calcMethod ? 'radio-active' : ''}} {{w}}radio"></div>
      </div>
    </div>

    <text class="section section-next {{w}}section {{w}}section-next {{r}}fit">{{asrMethodLabel}}</text>
    <div class="group {{w}}group {{r}}fit">
      <div class="option {{w}}option" for="{{asrMethods}}" onclick="selectAsrMethod($item.code)">
        <text class="option-label {{w}}option-label">{{$item.label}}</text>
        <div class="radio {{$item.code === asrMethod ? 'radio-active' : ''}} {{w}}radio"></div>
      </div>
    </div>

    <text class="section section-next {{w}}section {{w}}section-next {{r}}fit">{{languageLabel}}</text>
    <div class="group {{w}}group {{r}}fit">
      <div class="option {{w}}option" for="{{languages}}" onclick="select($item.code)">
        <text class="option-label {{w}}option-label">{{$item.label}}</text>
        <div class="radio {{$item.code === active ? 'radio-active' : ''}} {{w}}radio"></div>
      </div>
    </div>

    <text class="section section-next {{w}}section {{w}}section-next {{r}}fit">{{scriptLabel}}</text>
    <div class="group {{w}}group {{r}}fit">
      <div class="option {{w}}option" for="{{scripts}}" onclick="selectScript($item.code)">
        <text class="option-label {{w}}option-label">{{$item.label}}</text>
        <div class="radio {{$item.code === script ? 'radio-active' : ''}} {{w}}radio"></div>
      </div>
    </div>

    <text class="section section-next {{w}}section {{w}}section-next {{r}}fit">{{clockScreenLabel}}</text>
    <div class="group {{w}}group {{r}}fit">
      <div class="option {{w}}option" for="{{clockScreens}}" onclick="selectClockScreen($item.code)">
        <text class="option-label {{w}}option-label">{{$item.label}}</text>
        <div class="radio {{$item.code === clockScreen ? 'radio-active' : ''}} {{w}}radio"></div>
      </div>
    </div>

    <text class="section section-next {{w}}section {{w}}section-next {{r}}fit">{{clockThemeLabel}}</text>
    <div class="group {{w}}group {{r}}fit">
      <div class="option {{w}}option" for="{{clockThemes}}" onclick="selectClockTheme($item.code)">
        <div class="swatch-row">
          <div class="swatch {{w}}swatch" style="background-color: {{$item.accent}};"></div>
          <text class="option-label {{w}}option-label">{{$item.label}}</text>
        </div>
        <div class="radio {{$item.code === clockTheme ? 'radio-active' : ''}} {{w}}radio"></div>
      </div>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import { LANGUAGES, SCRIPTS, STRINGS, loadLanguage, saveLanguage, loadScript, saveScript } from '../../common/i18n.js'
import { CITIES, loadCity, saveCalcMethod, saveAsrMethod } from '../../common/cities.js'
import { CALC_METHOD_ORDER, ASR_SHADOWS } from '../../common/prayer.js'
import {
  loadLayout,
  CLOCK_SCREENS,
  loadClockScreen,
  saveClockScreen,
  CLOCK_THEMES,
  CLOCK_THEME_ORDER,
  loadClockTheme,
  saveClockTheme
} from '../../common/screen.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    languages: LANGUAGES,
    active: 'id',
    title: STRINGS.id.settings,
    languageLabel: STRINGS.id.language,
    cityLabel: STRINGS.id.city,
    scriptLabel: STRINGS.id.script,
    scripts: [],
    script: 'latin',
    clockScreenLabel: STRINGS.id.clockScreen,
    clockScreens: [],
    clockScreen: 'auto',
    clockThemeLabel: STRINGS.id.clockTheme,
    clockThemes: [],
    clockTheme: 'green',
    cityName: CITIES[0].name,
    calcMethodLabel: STRINGS.id.calcMethod,
    calcMethods: [],
    calcMethod: 'kemenag',
    asrMethodLabel: STRINGS.id.asrMethod,
    asrMethods: [],
    asrMethod: 'shafii'
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    loadLanguage((lang) => this.apply(lang))
    loadScript((code) => (this.script = code))
    loadClockScreen((code) => (this.clockScreen = code))
    loadClockTheme((code) => (this.clockTheme = code))
  },

  // Also runs when returning from the city picker
  onShow() {
    loadCity((city) => {
      this.cityName = city.name
      this.calcMethod = city.method
      this.asrMethod = city.asr
    })
  },

  openCities() {
    router.push({ uri: '/pages/cities' })
  },

  select(code) {
    saveLanguage(code)
    this.apply(code)
  },

  selectCalcMethod(code) {
    saveCalcMethod(code)
    this.calcMethod = code
  },

  selectAsrMethod(code) {
    saveAsrMethod(code)
    this.asrMethod = code
  },

  selectScript(code) {
    saveScript(code)
    this.script = code
  },

  selectClockScreen(code) {
    saveClockScreen(code)
    this.clockScreen = code
  },

  selectClockTheme(code) {
    saveClockTheme(code)
    this.clockTheme = code
  },

  apply(lang) {
    this.active = lang
    this.title = STRINGS[lang].settings
    this.languageLabel = STRINGS[lang].language
    this.cityLabel = STRINGS[lang].city
    this.scriptLabel = STRINGS[lang].script
    this.scripts = SCRIPTS.map((code) => ({ code, label: STRINGS[lang].scripts[code] }))
    this.calcMethodLabel = STRINGS[lang].calcMethod
    this.calcMethods = CALC_METHOD_ORDER.map((code) => ({ code, label: STRINGS[lang].calcMethods[code] }))
    this.asrMethodLabel = STRINGS[lang].asrMethod
    this.asrMethods = Object.keys(ASR_SHADOWS).map((code) => ({ code, label: STRINGS[lang].asrMethods[code] }))
    this.clockScreenLabel = STRINGS[lang].clockScreen
    this.clockScreens = CLOCK_SCREENS.map((code) => ({ code, label: STRINGS[lang].clockScreens[code] }))
    this.clockThemeLabel = STRINGS[lang].clockTheme
    this.clockThemes = CLOCK_THEME_ORDER.map((code) => ({
      code,
      label: STRINGS[lang].clockThemes[code],
      accent: CLOCK_THEMES[code].accent
    }))
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
}

.section {
  width: 168px;
  font-size: 15px;
  color: #8e8e93;
  margin-bottom: 6px;
}

.section-next {
  margin-top: 14px;
}

.group {
  flex-direction: column;
  width: 176px;
  padding: 4px 0;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.option {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 52px;
  padding: 0 16px;
}

.option-label {
  font-size: 18px;
  color: #ffffff;
}

.swatch-row {
  flex-direction: row;
  align-items: center;
}

.swatch {
  width: 14px;
  height: 14px;
  border-radius: 7px;
  margin-right: 10px;
}

.chevron {
  font-size: 22px;
  color: #8e8e93;
}

.radio {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  border-width: 2px;
  border-color: #636366;
}

.radio-active {
  border-width: 6px;
  border-color: #1fa77a;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
  margin-bottom: 10px;
}

.w-section {
  font-size: 9px;
  margin-bottom: 4px;
}

.w-section-next {
  margin-top: 8px;
}

.w-group {
  padding: 2px 0;
  border-radius: 13px;
}

.w-option {
  height: 31px;
  padding: 0 10px;
}

.w-option-label {
  font-size: 11px;
}

.w-swatch {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  margin-right: 6px;
}

.w-chevron {
  font-size: 13px;
}

.w-radio {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  border-width: 1px;
}

.w-radio-active {
  border-width: 4px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
