<template>
  <scroll class="page {{w}}page" scroll-y="true">
    <text class="title {{w}}title">{{t.today}}</text>

    <!-- Gregorian and Hijri dates as two calendar tiles -->
    <div class="dates {{w}}dates">
      <div class="tile {{w}}tile">
        <text class="tile-top {{w}}tile-top">{{weekday}}</text>
        <text class="tile-day {{w}}tile-day">{{gDay}}</text>
        <text class="tile-month {{w}}tile-month">{{gMonth}}</text>
      </div>
      <div class="tile {{w}}tile">
        <text class="tile-top {{w}}tile-top">{{hYear}}</text>
        <text class="tile-day hijri-day {{w}}tile-day">{{hDay}}</text>
        <text class="tile-month hijri-month {{w}}tile-month">{{hMonth}}</text>
      </div>
    </div>

    <div class="hero {{w}}hero">
      <div class="hero-main {{w}}hero-main">
        <text class="hero-label {{w}}hero-label">{{nextLabel}}</text>
        <text class="hero-time {{w}}hero-time">{{nextTime}}</text>
      </div>
      <div class="hero-side {{w}}hero-side">
        <div class="pill {{w}}pill">
          <text class="pill-text {{w}}pill-text">{{countdown}}</text>
        </div>
        <text class="city {{w}}city">{{city}}</text>
      </div>
    </div>

    <div class="card {{w}}card">
      <text class="section {{w}}section">{{t.fasting}}</text>
      <text class="when {{w}}when">{{t.todayLabel}}</text>
      <text class="fast {{w}}fast {{todayStyle}}">{{todayFasts}}</text>
      <div class="divider {{w}}divider"></div>
      <text class="when {{w}}when">{{t.tomorrowLabel}}</text>
      <text class="fast {{w}}fast {{tomorrowStyle}}">{{tomorrowFasts}}</text>
    </div>
  </scroll>
</template>

<script>
import { nextPrayer, prayerDate, formatMinutes } from '../../common/prayer.js'
import { prayerAlert } from '../../common/alert.js'
import { STRINGS, loadLanguage, formatDuration } from '../../common/i18n.js'
import { CITIES, TIME_ZONES, loadCity } from '../../common/cities.js'
import { toHijriWithOffset, loadHijriOffset } from '../../common/hijri.js'
import { fastsFor } from '../../common/fasting.js'
import { keepScreenOn, loadLayout } from '../../common/screen.js'

// Style for a fasting line: highlighted when there is a fast, red when fasting is not allowed
function fastStyle(keys) {
  if (keys[0] === 'none') return 'fast-none'
  if (keys[0] === 'eid' || keys[0] === 'tashriq') return 'fast-forbidden'
  return ''
}

export default {
  private: {
    w: '',
    t: STRINGS.id,
    weekday: '',
    gDay: '',
    gMonth: '',
    hYear: '',
    hDay: '',
    hMonth: '',
    nextLabel: '',
    nextTime: '',
    countdown: '',
    city: '',
    todayFasts: '',
    todayStyle: '',
    tomorrowFasts: '',
    tomorrowStyle: ''
  },

  onInit() {
    this.cityData = CITIES[0]
    this.offset = 0
    this.refresh()
    loadLayout((w) => (this.w = w))
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.refresh()
    })
    loadCity((city) => {
      this.cityData = city
      this.refresh()
    })
    loadHijriOffset((offset) => {
      this.offset = offset
      this.refresh()
    })
    // The countdown ticks every second; the rest only changes at the next prayer
    this.timer = setInterval(() => this.tick(), 1000)
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  tick() {
    const seconds = Math.ceil((this.target - Date.now()) / 1000)
    // Full refresh at the next prayer, and once a minute for the date
    this.ticks = (this.ticks || 0) + 1
    if (seconds <= 0) prayerAlert(this.t, this.nextKey)
    if (seconds <= 0 || this.ticks % 60 === 0) this.refresh()
    else this.countdown = formatDuration(this.t, seconds)
  },

  refresh() {
    const t = this.t
    const now = new Date()
    const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1)

    const h = toHijriWithOffset(now, this.offset)
    const zh = t === STRINGS.zh
    this.weekday = t.weekdays[now.getDay()]
    this.gDay = String(now.getDate())
    this.gMonth = zh ? now.getFullYear() + '年' + t.months[now.getMonth()] : t.months[now.getMonth()] + ' ' + now.getFullYear()
    this.hYear = h.year + (zh ? ' 年' : ' H')
    this.hDay = String(h.day)
    this.hMonth = t.hijriMonths[h.month - 1]

    const next = nextPrayer(now, this.cityData)
    this.nextKey = next.key
    this.nextLabel = t.prayers[next.key]
    this.nextTime = formatMinutes(next.times[next.key])
    this.target = prayerDate(next.day, next.times[next.key]).getTime()
    this.tick()
    this.city = this.cityData.name + ' · ' + TIME_ZONES[this.cityData.tz]

    const todayKeys = fastsFor(now, h)
    const tomorrowKeys = fastsFor(tomorrow, toHijriWithOffset(tomorrow, this.offset))
    this.todayFasts = todayKeys.map((k) => t.fasts[k]).join(', ')
    this.todayStyle = fastStyle(todayKeys)
    this.tomorrowFasts = tomorrowKeys.map((k) => t.fasts[k]).join(', ')
    this.tomorrowStyle = fastStyle(tomorrowKeys)
  }
}
</script>

