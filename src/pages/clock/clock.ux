<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true" onswipe="onSwipe" onlongpress="nextTheme">
    <text class="date {{w}}date">{{gregorian}}</text>
    <div class="time-row">
      <text class="time {{w}}time" style="{{timeSize}}">{{hours}}</text>
      <text class="time colon {{w}}colon" style="color: {{c.accent}}; {{timeSize}}">:</text>
      <text class="time {{w}}time" style="{{timeSize}}">{{minutes}}</text>
      <text class="period {{w}}period" if="{{period}}">{{period}}</text>
    </div>
    <div class="track {{w}}track {{r}}fit">
      <div class="seconds-fill {{w}}seconds-fill" style="width: {{secondsBar}}px; background-color: {{c.accent}};"></div>
    </div>
    <text class="hijri {{w}}hijri {{r}}fit" style="font-size: {{hijriSize}}px;">{{hijri}}</text>

    <div class="panels {{w}}panels {{r}}fit">
      <div class="hero {{w}}hero {{r}}hero" style="background-color: {{c.heroBg}};">
        <div class="hero-row {{w}}hero-row">
          <text class="hero-label {{w}}hero-label" style="color: {{c.accent}}; {{labelSize}}">{{nextLabel}}</text>
          <text class="hero-time {{w}}hero-time">{{nextTime}}</text>
        </div>
        <div class="hero-track {{w}}hero-track {{r}}hero-track" style="background-color: {{c.heroTrack}};">
          <div class="hero-fill {{w}}hero-fill" style="width: {{prayerBar}}px; background-color: {{c.accent}};"></div>
        </div>
        <div class="status">
          <div class="blink {{w}}blink" if="{{arrived}}" style="background-color: {{blink}};"></div>
          <text class="countdown {{w}}countdown" style="color: {{c.soft}};">{{countdown}}</text>
        </div>
      </div>

      <div class="schedule {{w}}schedule {{r}}schedule">
        <div class="row {{w}}row" style="{{$item.bg}}" for="{{schedule}}">
          <div class="dot {{w}}dot {{$item.style}}-dot"></div>
          <text class="row-label {{w}}row-text {{$item.style}}-text">{{$item.label}}</text>
          <text class="row-time {{w}}row-text {{$item.style}}-text">{{$item.time}}</text>
        </div>
      </div>
    </div>

    <text class="footer {{w}}footer" style="font-size: {{footerSize}}px;">{{footer}}</text>
  </scroll>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import vibrator from '@system.vibrator'
import battery from '@system.battery'
import {
  prayerTimes,
  nextPrayer,
  prayerDate,
  prayerName,
  formatMinutes,
  placeNow,
  realTime,
  PRAYER_ORDER
} from '../../common/prayer.js'
import { prayerAlert, LATE_ALERT } from '../../common/alert.js'
import { STRINGS, loadLanguage, formatDate } from '../../common/i18n.js'
import { loadCity } from '../../common/cities.js'
import { toHijriWithOffset, loadHijriOffset } from '../../common/hijri.js'
import { fastsFor, fastMoment, fastName } from '../../common/fasting.js'
import {
  loadLayout,
  keepScreenOn,
  loadClockScreen,
  loadClockFormat,
  CLOCK_THEMES,
  CLOCK_THEME_ORDER,
  loadClockTheme,
  saveClockTheme
} from '../../common/screen.js'
import { textWidth } from '../../common/text.js'
import { loadAll } from '../../common/load.js'

// The five daily prayers shown in the schedule
const DAILY = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha']

// Minutes the hero card stays on a prayer after its time arrives, before
// counting down to the next one
const HOLD = 10

// Inner widths of the seconds track and the hero card's progress track,
// on bands, on wide screens and on round watches
const SECONDS_WIDTH = { '': 120, 'w-': 176, 'r-': 160 }
const PRAYER_WIDTH = { '': 148, 'w-': 62, 'r-': 52 }

// Hijri date sizes, largest first: the first one that fits the line is used,
// so long month names don't push "H" onto a second line
const HIJRI_SIZES = { '': [15, 14, 13, 12], 'w-': [10, 9, 8] }
const HIJRI_WIDTH = 176

// Widest hero label (px, by textWidth) that stays at 18px beside the time on the band
const LABEL_WIDTH = 66

// Footer sizes and widths, the same way: the bottom of a round face is narrower
const FOOTER_SIZES = { '': [13, 12, 11], 'w-': [8, 7] }
const FOOTER_WIDTH = { '': 176, 'w-': 176, 'r-': 140 }

// Sizes for the band's big time, largest first: with AM/PM beside it, a
// two-digit hour steps down until the row fits the screen
const TIME_SIZES = [64, 60, 56, 52, 48]
const TIME_WIDTH = 176

const pad = (n) => (n < 10 ? '0' : '') + n

// The countdown to the next prayer, as 03:05:09
const countdownText = (s) => pad(Math.floor(s / 3600)) + ':' + pad(Math.floor(s / 60) % 60) + ':' + pad(s % 60)

// When the stretch leading up to `next` began: the prayer before it,
// or yesterday's Isha before Imsak
function previousStart(now, next, location) {
  const today = prayerTimes(now, location)
  if (next.tomorrow) return prayerDate(now, today.isha)
  const order = PRAYER_ORDER.filter((k) => k !== 'sunrise')
  const i = order.indexOf(next.key)
  if (i > 0) return prayerDate(now, today[order[i - 1]])
  const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1)
  return prayerDate(yesterday, prayerTimes(yesterday, location).isha)
}

// The daily prayer whose time came less than HOLD minutes ago, if any.
// Prayer times are whole minutes, so the refresh at every new minute ends the hold
function arrivedPrayer(now, location) {
  const times = prayerTimes(now, location)
  const nowMinutes = now.getHours() * 60 + now.getMinutes()
  const key = DAILY.find((k) => times[k] <= nowMinutes && nowMinutes < times[k] + HOLD)
  return key && { key, day: now, times, nowMinutes, tomorrow: false }
}

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    c: CLOCK_THEMES.green,
    gregorian: '',
    hours: '',
    minutes: '',
    period: '',
    timeSize: '',
    secondsBar: 0,
    hijri: '',
    hijriSize: 15,
    nextLabel: '',
    labelSize: '',
    nextTime: '',
    prayerBar: 0,
    countdown: '',
    arrived: false,
    blink: '',
    schedule: [],
    footer: '',
    footerSize: 13
  },

  onInit() {
    this.batteryText = ''
    loadAll(
      {
        layout: loadLayout,
        lang: loadLanguage,
        city: loadCity,
        offset: loadHijriOffset,
        theme: loadClockTheme,
        format: loadClockFormat
      },
      (v) => {
        this.w = v.layout[0]
        this.frame = v.layout[1]
        this.r = v.layout[2]
        this.t = STRINGS[v.lang]
        this.cityData = v.city
        this.offset = v.offset
        this.theme = v.theme
        this.format = v.format
        this.c = CLOCK_THEMES[v.theme]
        this.ready = true
        this.refresh()
      }
    )
  },

  // The screen turns off as usual unless Settings keeps it on for Clock, so
  // the prayer-time alert fires on time. Timers stop while the screen is
  // off; the first tick after waking catches up, alerting for a prayer time
  // that passed in the meantime
  onShow() {
    loadClockScreen((code) => keepScreenOn(code === 'on'))
    clearTimeout(this.alarm)
    clearInterval(this.timer)
    this.timer = setInterval(() => this.tick(), 1000)
    this.tick()
  },

  // Behind the dhikr and Qibla pages nothing here needs to move, so the
  // per-second timer stops and a single timeout waits for the next prayer,
  // whose alert still arrives
  onHide() {
    keepScreenOn(false)
    clearInterval(this.timer)
    this.armAlarm()
  },

  onDestroy() {
    clearInterval(this.timer)
    clearTimeout(this.alarm)
  },

  armAlarm() {
    clearTimeout(this.alarm)
    if (!this.ready) return
    this.alarm = setTimeout(() => {
      if (Date.now() - this.target < LATE_ALERT * 1000) prayerAlert(this.t, this.nextKey)
      // Moves on to the following prayer, so showing Clock again does not alert twice
      this.refresh()
      this.armAlarm()
    }, Math.max(0, this.target - Date.now()))
  },

  // Listening for swipes takes over the system's swipe-back, so going back
  // on a right swipe is done here; swiping left opens the shortcuts (dhikr, Qibla)
  onSwipe(e) {
    if (e.direction === 'left') router.push({ uri: '/pages/dhikrmenu' })
    else if (e.direction === 'right') router.back()
  },

  // A long press switches to the next color theme, also picked in Settings
  nextTheme() {
    if (!this.ready) return
    const code = CLOCK_THEME_ORDER[(CLOCK_THEME_ORDER.indexOf(this.theme) + 1) % CLOCK_THEME_ORDER.length]
    saveClockTheme(code)
    this.applyTheme(code)
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
    try {
      prompt.showToast({ message: this.t.clockTheme + ': ' + this.t.clockThemes[code] })
    } catch (e) {}
  },

  applyTheme(code) {
    this.theme = code
    this.c = CLOCK_THEMES[code]
    this.refresh()
  },

  tick() {
    if (!this.ready) return
    const now = new Date()
    const left = Math.ceil((this.target - now.getTime()) / 1000)
    if (left <= 0 && left > -LATE_ALERT) prayerAlert(this.t, this.nextKey)
    // Full refresh at the next prayer and at every new minute
    if (left <= 0 || now.getMinutes() !== this.minute) this.refresh()
    else this.updateSeconds(now)
  },

  // Everything that moves every second: the seconds track, countdown and prayer
  // progress, or while a prayer's time has just arrived, a full track and a blinking dot
  updateSeconds(now) {
    const ms = now.getTime()
    this.secondsBar = Math.round((SECONDS_WIDTH[this.r || this.w] * now.getSeconds()) / 59)
    if (this.arrived) {
      this.countdown = this.t.prayerArrived
      this.blink = now.getSeconds() % 2 ? this.c.heroBg : this.c.accent
      this.prayerBar = PRAYER_WIDTH[this.r || this.w]
      return
    }
    this.countdown = countdownText(Math.max(0, Math.ceil((this.target - ms) / 1000)))
    const span = this.target - this.start
    this.prayerBar = Math.round(PRAYER_WIDTH[this.r || this.w] * Math.min(1, Math.max(0, (ms - this.start) / span)))
  },

  refresh() {
    const t = this.t
    const now = new Date()
    this.minute = now.getMinutes()
    this.showTime(now)
    this.gregorian = formatDate(t, now)

    const h = toHijriWithOffset(now, this.offset)
    this.hijri = h.day + ' ' + t.hijriMonths[h.month - 1] + ' ' + h.year + ' H'
    const sizes = HIJRI_SIZES[this.w]
    this.hijriSize = sizes.find((size) => textWidth(this.hijri, size) <= HIJRI_WIDTH) || sizes[sizes.length - 1]

    // The time, date and Hijri date above follow the band clock; the prayers,
    // the place's own time (they differ only for a place in another time zone)
    const here = placeNow(this.cityData)
    const hHere = toHijriWithOffset(here, this.offset)
    const next = nextPrayer(here, this.cityData)
    this.nextKey = next.key
    // The card and schedule stay on a prayer for HOLD minutes after its time
    // arrives; the alert still waits for the next one
    const arrived = arrivedPrayer(here, this.cityData)
    const shown = arrived || next
    this.arrived = !!arrived
    // In Ramadan, Maghrib is the iftar (always today's, as it comes before Isha)
    this.nextLabel = shown.key === 'maghrib' && hHere.month === 9 ? t.iftar : prayerName(t, shown.key, shown.day, true)
    // On the band the label shares a line with the 30px time: longer names
    // such as Maghrib and Berbuka step down to 16px to keep a gap between them
    this.labelSize = !this.w && textWidth(this.nextLabel, 18) > LABEL_WIDTH ? 'font-size: 16px;' : ''
    this.nextTime = formatMinutes(shown.times[shown.key], this.format)
    this.target = realTime(prayerDate(next.day, next.times[next.key]), this.cityData)
    this.start = realTime(previousStart(here, next, this.cityData), this.cityData)
    this.updateSeconds(now)

    // Passed prayers are dimmed and the shown one is highlighted; after Isha
    // the list shows tomorrow, so nothing is dimmed
    const schedule = DAILY.map((k) => {
      let style = 'upcoming'
      if (k === shown.key || (shown.key === 'imsak' && k === 'fajr')) style = 'next'
      else if (!shown.tomorrow && shown.times[k] <= shown.nowMinutes) style = 'past'
      const bg = style === 'next' ? 'background-color: ' + this.c.accent + ';' : ''
      return { label: prayerName(t, k, shown.day, true), time: formatMinutes(shown.times[k], this.format), style, bg }
    })
    // It changes only at a prayer time or a new theme, so it is redrawn only then
    const key = JSON.stringify(schedule)
    if (key !== this.scheduleKey) {
      this.scheduleKey = key
      this.schedule = schedule
    }

    // From Maghrib before a fast until its Imsak, the footer names the fast
    // instead of the city
    const tomorrow = new Date(here.getFullYear(), here.getMonth(), here.getDate() + 1)
    const todayKeys = fastsFor(here, hHere)
    const tomorrowKeys = fastsFor(tomorrow, toHijriWithOffset(tomorrow, this.offset))
    const fast = fastMoment(here, this.cityData, todayKeys, tomorrowKeys)
    if (fast && fast.key === 'imsak') {
      const isToday = fast.day === here
      this.footerLead = (isToday ? t.todayLabel : t.tomorrowLabel) + ': ' + fastName(t, isToday ? todayKeys : tomorrowKeys)
    } else {
      this.footerLead = this.cityData.name
    }
    this.updateBattery()
    this.showFooter()
  },

  // The big time, on the 12-hour clock with AM/PM beside it
  showTime(now) {
    const h = now.getHours()
    this.minutes = pad(now.getMinutes())
    if (this.format !== '12h') {
      this.hours = pad(h)
      this.period = ''
      this.timeSize = ''
      return
    }
    this.hours = String(h % 12 || 12)
    this.period = this.t.periods[h < 12 ? 0 : 1]
    // Digits ~0.6x the size, the colon and its margins ~0.35x + 4, then AM/PM
    // at 16px with its margin; wide screens have room at their own size
    const room = TIME_WIDTH - textWidth(this.period, 16) - 4
    const fits = (size) => textWidth(this.hours + this.minutes, size) + size * 0.35 + 4 <= room
    const size = this.w ? 0 : TIME_SIZES.find(fits) || TIME_SIZES[TIME_SIZES.length - 1]
    this.timeSize = size && size !== TIME_SIZES[0] ? 'font-size: ' + size + 'px;' : ''
  },

  // The footer lead, with the battery level when it fits, at the largest size that fits
  showFooter() {
    const sizes = FOOTER_SIZES[this.w]
    const width = FOOTER_WIDTH[this.r || this.w]
    const full = this.footerLead + (this.batteryText ? ' · ' + this.batteryText : '')
    const fits = (text) => sizes.find((size) => textWidth(text, size) <= width)
    this.footer = fits(full) ? full : this.footerLead
    this.footerSize = fits(this.footer) || sizes[sizes.length - 1]
  },

  // Only where the battery API exists (not on Smart Band 9 / 9 Pro)
  updateBattery() {
    try {
      battery.getStatus({
        success: (status) => {
          this.batteryText = Math.round(status.level * 100) + '%'
          this.showFooter()
        }
      })
    } catch (e) {}
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 32px 8px 16px 8px;
  background-color: #000000;
}

.date {
  font-size: 16px;
  font-weight: bold;
  color: #8e8e93;
}

.time-row {
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.time {
  font-size: 64px;
  font-weight: bold;
  color: #ffffff;
}

.colon {
  margin: 0 2px 6px 2px;
}

/* AM/PM, small and level with the top of the digits */
.period {
  font-size: 16px;
  font-weight: bold;
  color: #8e8e93;
  margin: 0 0 22px 4px;
}

.track {
  width: 120px;
  height: 4px;
  border-radius: 2px;
  margin-bottom: 8px;
  background-color: #1c1c1e;
}

.seconds-fill {
  height: 4px;
  border-radius: 2px;
}

/* Plain centered text rather than a pill, so long month names fit on one line */
.hijri {
  width: 176px;
  font-size: 15px;
  font-weight: bold;
  text-align: center;
  color: #ff9f0a;
  margin-bottom: 12px;
}

.panels {
  flex-direction: column;
}

.hero {
  flex-direction: column;
  width: 176px;
  padding: 12px 14px;
  margin-bottom: 8px;
  border-radius: 24px;
}

.hero-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.hero-label {
  font-size: 18px;
  font-weight: bold;
}

.hero-time {
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}

.hero-track {
  width: 148px;
  height: 6px;
  margin: 8px 0 6px 0;
  border-radius: 3px;
}

.hero-fill {
  height: 6px;
  border-radius: 3px;
}

.status {
  flex-direction: row;
  align-items: center;
}

/* Blinks beside "It's time" while a prayer's time has just arrived */
.blink {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-right: 6px;
}

.countdown {
  font-size: 14px;
}

.schedule {
  flex-direction: column;
  width: 176px;
  padding: 6px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.row {
  flex-direction: row;
  align-items: center;
  height: 28px;
  padding: 0 10px;
  border-radius: 14px;
}

/* Strong contrast throughout so the schedule stays readable in sunlight:
   the next prayer is a solid row in the theme's accent with black text */
.dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-right: 8px;
}

.upcoming-dot {
  background-color: #ffffff;
}

.next-dot {
  background-color: #000000;
}

.past-dot {
  background-color: #636366;
}

.row-label {
  flex: 1;
  font-size: 16px;
  font-weight: bold;
}

.row-time {
  font-size: 16px;
  font-weight: bold;
}

.upcoming-text {
  color: #ffffff;
}

.next-text {
  color: #000000;
}

.past-text {
  color: #aeaeb2;
}

.footer {
  font-size: 13px;
  color: #aeaeb2;
  margin-top: 8px;
}

/* Wide screens (Band 9 Pro): smaller type, and the next prayer and the
   schedule sit side by side */
.w-page {
  height: 274px;
  padding: 8px 8px 8px 8px;
}

.w-date {
  font-size: 10px;
}

.w-time {
  font-size: 40px;
}

.w-colon {
  margin: 0 1px 4px 1px;
}

.w-period {
  font-size: 10px;
  margin: 0 0 14px 3px;
}

.w-track {
  width: 176px;
  height: 3px;
  margin-bottom: 4px;
}

.w-seconds-fill {
  height: 3px;
}

.w-hijri {
  font-size: 10px;
  margin-bottom: 6px;
}

.w-panels {
  flex-direction: row;
  justify-content: space-between;
  width: 176px;
}

.w-hero {
  width: 78px;
  padding: 8px;
  margin-bottom: 0;
  border-radius: 14px;
}

.w-hero-row {
  flex-direction: column;
  align-items: flex-start;
}

.w-hero-label {
  font-size: 11px;
}

.w-hero-time {
  font-size: 18px;
}

.w-hero-track {
  width: 62px;
  height: 4px;
  margin: 6px 0 4px 0;
}

.w-hero-fill {
  height: 4px;
}

.w-blink {
  width: 4px;
  height: 4px;
  border-radius: 2px;
  margin-right: 3px;
}

.w-countdown {
  font-size: 7px;
}

.w-schedule {
  width: 94px;
  padding: 4px;
  border-radius: 14px;
}

.w-row {
  height: 16px;
  padding: 0 5px;
  border-radius: 8px;
}

.w-dot {
  width: 4px;
  height: 4px;
  border-radius: 2px;
  margin-right: 4px;
}

.w-row-text {
  font-size: 10px;
}

.w-footer {
  font-size: 8px;
  margin-top: 6px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}

.r-hero {
  width: 68px;
}

.r-hero-track {
  width: 52px;
}

.r-schedule {
  width: 88px;
}
</style>
