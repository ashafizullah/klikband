<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{title}}</text>
    <text class="subtitle {{w}}subtitle">{{location}}</text>
    <text class="subtitle subtitle-last {{w}}subtitle {{w}}subtitle-last">{{dateText}}</text>

    <div class="panels {{w}}panels {{r}}fit">
      <div class="hero {{w}}hero {{r}}hero">
        <text class="hero-label {{w}}hero-label">{{nextLabel}}</text>
        <text class="hero-time {{w}}hero-time">{{nextTime}}</text>
        <div class="pill {{w}}pill">
          <text class="pill-text {{w}}pill-text">{{countdown}}</text>
        </div>
      </div>

      <div class="list {{w}}list {{r}}list">
        <div class="row {{w}}row {{r}}row {{$item.next ? 'row-next' : ''}}" for="{{rows}}">
          <text class="name {{w}}cell {{$item.style}}">{{$item.label}}</text>
          <text class="time {{w}}cell {{$item.style}}">{{$item.time}}</text>
        </div>
      </div>
    </div>

    <!-- Voluntary prayer windows and the times prayer is not allowed: the one
         under way is highlighted, green or red -->
    <div class="extras {{w}}extras {{r}}fit {{r}}extras">
      <div class="card {{w}}card {{r}}card" for="{{card in cards}}">
        <text class="section {{w}}section">{{card.title}}</text>
        <div class="slot {{w}}slot slot-{{slot.style}}" for="{{slot in card.rows}}">
          <text class="slot-label {{w}}slot-label">{{slot.label}}</text>
          <text class="slot-time {{w}}slot-time time-{{slot.style}}">{{slot.time}}</text>
        </div>
      </div>
    </div>
  </scroll>
</template>

<script>
import {
  PRAYER_ORDER,
  nextPrayer,
  prayerDate,
  prayerName,
  formatMinutes,
  sunnahTimes,
  lastThirdOfNight,
  placeNow,
  realTime
} from '../../common/prayer.js'
import { prayerAlert, LATE_ALERT } from '../../common/alert.js'
import { STRINGS, loadLanguage, formatDate, formatDuration } from '../../common/i18n.js'
import { zoneLabel, loadCity } from '../../common/cities.js'
import { keepScreenOn, loadLayout, loadClockFormat } from '../../common/screen.js'
import { loadAll } from '../../common/load.js'

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    title: '',
    location: '',
    dateText: '',
    nextLabel: '',
    nextTime: '',
    countdown: '',
    rows: [],
    cards: []
  },

  onInit() {
    loadAll({ layout: loadLayout, lang: loadLanguage, city: loadCity, format: loadClockFormat }, (v) => {
      this.w = v.layout[0]
      this.frame = v.layout[1]
      this.r = v.layout[2]
      this.t = STRINGS[v.lang]
      this.city = v.city
      this.format = v.format
      this.refresh()
      // The countdown ticks every second; the rest only changes at the next prayer
      this.timer = setInterval(() => this.tick(), 1000)
    })
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  tick() {
    const seconds = Math.ceil((this.target - Date.now()) / 1000)
    // Full refresh at the next prayer, and once a minute for the date
    this.ticks = (this.ticks || 0) + 1
    if (seconds <= 0 && seconds > -LATE_ALERT) prayerAlert(this.t, this.nextKey)
    if (seconds <= 0 || this.ticks % 60 === 0) this.refresh()
    else this.countdown = formatDuration(this.t, seconds)
  },

  refresh() {
    const t = this.t
    // After Isha this is tomorrow's schedule, so the card and the list match
    // In the place's own time (it differs from the band clock only for a place
    // in another time zone)
    const { key: next, day, times, nowMinutes, tomorrow } = nextPrayer(placeNow(this.city), this.city)

    this.title = t.prayer
    this.location = this.city.name + ' · ' + zoneLabel(this.city)
    this.dateText = formatDate(t, day)
    this.nextKey = next
    // The full Friday name fits the band's wide card, not the narrow ones
    this.nextLabel = prayerName(t, next, day, !!(this.w || this.r))
    this.nextTime = formatMinutes(times[next], this.format)
    this.target = realTime(prayerDate(day, times[next]), this.city)
    this.tick()
    const rows = PRAYER_ORDER.map((k) => ({
      label: prayerName(t, k, day, true),
      time: formatMinutes(times[k], this.format),
      next: k === next,
      // Past times are dimmed, the next one is highlighted
      style: k === next ? 'text-next' : !tomorrow && times[k] <= nowMinutes ? 'text-past' : ''
    }))
    const cards = this.extraCards(day, tomorrow, nowMinutes)
    // The lists change only a few times a day, so the refresh every minute
    // redraws them only then
    const key = JSON.stringify([rows, cards])
    if (key !== this.listsKey) {
      this.listsKey = key
      this.rows = rows
      this.cards = cards
    }
  },

  // The shown day's Dhuha and not-allowed times, and tonight's last third
  extraCards(day, tomorrow, nowMinutes) {
    const t = this.t
    const s = sunnahTimes(day, this.city)
    const here = placeNow(this.city)
    const night = lastThirdOfNight(here, this.city)
    const span = (r) => formatMinutes(r[0], this.format) + '–' + formatMinutes(r[1], this.format)
    const until = (r) => t.until.replace('{time}', formatMinutes(r[1], this.format))
    // `now` in minutes since the window's own midnight
    const style = (r, now, active) => (now >= r[1] ? 'past' : now >= r[0] ? active : 'plain')
    const dayStyle = (r, active) => (tomorrow ? 'plain' : style(r, nowMinutes, active))
    const sinceEvening = Math.floor((here.getTime() - night.evening.getTime()) / 60000)
    return [
      {
        title: t.sunnahTimes,
        rows: [
          { label: t.dhuha, time: span(s.dhuha), style: dayStyle(s.dhuha, 'good') },
          { label: t.lastThird, time: span(night.range), style: style(night.range, sinceEvening, 'good') }
        ]
      },
      {
        title: t.notAllowed,
        rows: [
          { label: t.afterFajr, time: until(s.afterFajr), style: dayStyle(s.afterFajr, 'bad') },
          { label: t.zenith, time: span(s.zenith), style: dayStyle(s.zenith, 'bad') },
          { label: t.afterAsr, time: until(s.afterAsr), style: dayStyle(s.afterAsr, 'bad') }
        ]
      }
    ]
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

