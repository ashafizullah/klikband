<template>
  <scroll class="page" scroll-y="true">
    <text class="title">{{title}}</text>
    <div class="card" for="{{menu}}" onclick="openPage($item.uri)">
      <div class="icon" style="background-color: {{$item.color}};">
        <image class="icon-image" src="{{$item.icon}}"></image>
      </div>
      <marquee if="{{$item.long}}" id="m{{$idx}}" class="label" scrollamount="30" text-offset="40">{{$item.label}}</marquee>
      <text else class="label">{{$item.label}}</text>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { textWidth, startMarquees } from '../../common/text.js'

// Label area: 176 card - 24 padding - 46 icon - 10 gap
const LABEL_WIDTH = 96

const MENU = [
  { key: 'today', color: '#0A84FF' },
  { key: 'prayer', color: '#1FA77A' },
  { key: 'dhikr', color: '#30B0C7' },
  { key: 'morningevening', color: '#5E5CE6' },
  { key: 'tasbih', color: '#3D7BFF' },
  { key: 'hijri', color: '#FF9F0A' },
  { key: 'holidays', color: '#FF375F' },
  { key: 'asmaulhusna', color: '#BF5AF2' },
  { key: 'duas', color: '#FF6B6B' }
]

function buildMenu(lang) {
  const t = STRINGS[lang]
  return MENU.map((m) => ({
    label: t[m.key],
    long: textWidth(t[m.key], 19) > LABEL_WIDTH,
    icon: '/common/icons/' + m.key + '.png',
    color: m.color,
    uri: '/pages/' + m.key
  }))
}

export default {
  private: {
    title: STRINGS.id.islam,
    menu: buildMenu('id')
  },

  onInit() {
    loadLanguage((lang) => this.apply(lang))
  },

  onShow() {
    loadLanguage((lang) => this.apply(lang))
  },

  onReady() {
    startMarquees(this, MENU.length)
  },

  apply(lang) {
    this.title = STRINGS[lang].islam
    this.menu = buildMenu(lang)
  },

  openPage(uri) {
    router.push({ uri })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
}

.card {
  flex-direction: row;
  align-items: center;
  width: 176px;
  height: 76px;
  padding: 0 12px;
  margin-bottom: 8px;
  border-radius: 26px;
  background-color: #1c1c1e;
}

.icon {
  justify-content: center;
  align-items: center;
  width: 46px;
  height: 46px;
  border-radius: 23px;
  margin-right: 10px;
}

.icon-image {
  width: 27px;
  height: 27px;
}

.label {
  width: 96px;
  font-size: 19px;
  font-weight: bold;
  color: #ffffff;
}
</style>
