<template>
  <scroll class="page {{w}}page" style="{{frame}}" scroll-y="true" onswipe="onSwipe">
    <text class="date {{w}}date">{{gregorian}}</text>
    <div class="time-row">
      <text class="time {{w}}time">{{hours}}</text>
      <text class="time colon {{w}}colon">:</text>
      <text class="time {{w}}time">{{minutes}}</text>
    </div>
    <div class="track {{w}}track {{r}}fit">
      <div class="seconds-fill {{w}}seconds-fill" style="width: {{secondsBar}}px;"></div>
    </div>
    <text class="hijri {{w}}hijri {{r}}fit" style="font-size: {{hijriSize}}px;">{{hijri}}</text>

    <div class="panels {{w}}panels {{r}}fit">
      <div class="hero {{w}}hero {{r}}hero">
        <div class="hero-row {{w}}hero-row">
          <text class="hero-label {{w}}hero-label">{{nextLabel}}</text>
          <text class="hero-time {{w}}hero-time">{{nextTime}}</text>
        </div>
        <div class="hero-track {{w}}hero-track {{r}}hero-track">
          <div class="hero-fill {{w}}hero-fill" style="width: {{prayerBar}}px;"></div>
        </div>
        <text class="countdown {{w}}countdown">{{countdown}}</text>
      </div>

      <div class="schedule {{w}}schedule {{r}}schedule">
        <div class="row {{w}}row {{$item.style}}" for="{{schedule}}">
          <div class="dot {{w}}dot {{$item.style}}-dot"></div>
          <text class="row-label {{w}}row-text {{$item.style}}-text">{{$item.label}}</text>
          <text class="row-time {{w}}row-text {{$item.style}}-text">{{$item.time}}</text>
        </div>
      </div>
    </div>

    <text class="footer {{w}}footer">{{footer}}</text>
  </scroll>
</template>

<script>
import router from '@system.router'
import battery from '@system.battery'
import { prayerTimes, nextPrayer, prayerDate, formatMinutes, PRAYER_ORDER } from '../../common/prayer.js'
import { prayerAlert } from '../../common/alert.js'
import { STRINGS, loadLanguage, formatDate, formatDuration } from '../../common/i18n.js'
import { CITIES, loadCity } from '../../common/cities.js'
import { toHijriWithOffset, loadHijriOffset } from '../../common/hijri.js'
import { loadLayout } from '../../common/screen.js'
import { textWidth } from '../../common/text.js'

// The five daily prayers shown in the schedule
const DAILY = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha']

// Inner widths of the seconds track and the hero card's progress track,
// on bands, on wide screens and on round watches
const SECONDS_WIDTH = { '': 120, 'w-': 176, 'r-': 160 }
const PRAYER_WIDTH = { '': 148, 'w-': 62, 'r-': 52 }

// Hijri date sizes, largest first: the first one that fits the line is used,
// so long month names don't push "H" onto a second line
const HIJRI_SIZES = { '': [15, 14, 13, 12], 'w-': [10, 9, 8] }
const HIJRI_WIDTH = 176

const pad = (n) => (n < 10 ? '0' : '') + n

// When the stretch leading up to `next` began: the prayer before it,
// or yesterday's Isha before Imsak
function previousStart(now, next, location) {
  const today = prayerTimes(now, location)
  if (next.tomorrow) return prayerDate(now, today.isha)
  const order = PRAYER_ORDER.filter((k) => k !== 'sunrise')
  const i = order.indexOf(next.key)
  if (i > 0) return prayerDate(now, today[order[i - 1]])
  const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1)
  return prayerDate(yesterday, prayerTimes(yesterday, location).isha)
}

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    gregorian: '',
    hours: '',
    minutes: '',
    secondsBar: 0,
    hijri: '',
    hijriSize: 15,
    nextLabel: '',
    nextTime: '',
    prayerBar: 0,
    countdown: '',
    schedule: [],
    footer: ''
  },

  onInit() {
    this.t = STRINGS.id
    this.cityData = CITIES[0]
    this.offset = 0
    this.batteryText = ''
    this.refresh()
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
      this.refresh()
    })
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.refresh()
    })
    loadCity((city) => {
      this.cityData = city
      this.refresh()
    })
    loadHijriOffset((offset) => {
      this.offset = offset
      this.refresh()
    })
    this.timer = setInterval(() => this.tick(), 1000)
  },

  // The screen turns off as usual; catch up right away when it wakes again
  onShow() {
    this.refresh()
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  // Listening for swipes takes over the system's swipe-back, so going back
  // on a right swipe is done here; swiping left opens the shortcuts (dhikr, Qibla)
  onSwipe(e) {
    if (e.direction === 'left') router.push({ uri: '/pages/dhikrmenu' })
    else if (e.direction === 'right') router.back()
  },

  tick() {
    const now = new Date()
    const left = Math.ceil((this.target - now.getTime()) / 1000)
    if (left <= 0) prayerAlert(this.t, this.nextKey)
    // Full refresh at the next prayer and at every new minute
    if (left <= 0 || now.getMinutes() !== this.minute) this.refresh()
    else this.updateSeconds(now)
  },

  // Everything that moves every second: the seconds track, countdown and prayer progress
  updateSeconds(now) {
    const ms = now.getTime()
    this.secondsBar = Math.round((SECONDS_WIDTH[this.r || this.w] * now.getSeconds()) / 59)
    this.countdown = formatDuration(this.t, Math.max(0, Math.ceil((this.target - ms) / 1000)))
    const span = this.target - this.start
    this.prayerBar = Math.round(PRAYER_WIDTH[this.r || this.w] * Math.min(1, Math.max(0, (ms - this.start) / span)))
  },

  refresh() {
    const t = this.t
    const now = new Date()
    this.minute = now.getMinutes()
    this.hours = pad(now.getHours())
    this.minutes = pad(now.getMinutes())
    this.gregorian = formatDate(t, now)

    const h = toHijriWithOffset(now, this.offset)
    this.hijri = h.day + ' ' + t.hijriMonths[h.month - 1] + ' ' + h.year + ' H'
    const sizes = HIJRI_SIZES[this.w]
    this.hijriSize = sizes.find((size) => textWidth(this.hijri, size) <= HIJRI_WIDTH) || sizes[sizes.length - 1]

    const next = nextPrayer(now, this.cityData)
    this.nextKey = next.key
    this.nextLabel = t.prayers[next.key]
    this.nextTime = formatMinutes(next.times[next.key])
    this.target = prayerDate(next.day, next.times[next.key]).getTime()
    this.start = previousStart(now, next, this.cityData).getTime()
    this.updateSeconds(now)

    // Passed prayers are dimmed and the next one is highlighted; after Isha
    // the list shows tomorrow, so nothing is dimmed
    this.schedule = DAILY.map((k) => {
      let style = 'upcoming'
      if (k === next.key || (next.key === 'imsak' && k === 'fajr')) style = 'next'
      else if (!next.tomorrow && next.times[k] <= next.nowMinutes) style = 'past'
      return { label: t.prayers[k], time: formatMinutes(next.times[k]), style }
    })

    this.updateBattery()
    this.footer = this.cityData.name + (this.batteryText ? ' · ' + this.batteryText : '')
  },

  // Only where the battery API exists (not on Smart Band 9 / 9 Pro)
  updateBattery() {
    try {
      battery.getStatus({
        success: (status) => {
          this.batteryText = Math.round(status.level * 100) + '%'
          this.footer = this.cityData.name + ' · ' + this.batteryText
        }
      })
    } catch (e) {}
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 32px 8px 16px 8px;
  background-color: #000000;
}

.date {
  font-size: 16px;
  font-weight: bold;
  color: #8e8e93;
}

.time-row {
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.time {
  font-size: 64px;
  font-weight: bold;
  color: #ffffff;
}

.colon {
  color: #34d399;
  margin: 0 2px 6px 2px;
}

.track {
  width: 120px;
  height: 4px;
  border-radius: 2px;
  margin-bottom: 8px;
  background-color: #1c1c1e;
}

.seconds-fill {
  height: 4px;
  border-radius: 2px;
  background-color: #34d399;
}

/* Plain centered text rather than a pill, so long month names fit on one line */
.hijri {
  width: 176px;
  font-size: 15px;
  font-weight: bold;
  text-align: center;
  color: #ff9f0a;
  margin-bottom: 12px;
}

.panels {
  flex-direction: column;
}

.hero {
  flex-direction: column;
  width: 176px;
  padding: 12px 14px;
  margin-bottom: 8px;
  border-radius: 24px;
  background-color: #0d3b2c;
}

.hero-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.hero-label {
  font-size: 18px;
  font-weight: bold;
  color: #34d399;
}

.hero-time {
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}

.hero-track {
  width: 148px;
  height: 6px;
  margin: 8px 0 6px 0;
  border-radius: 3px;
  background-color: #145c44;
}

.hero-fill {
  height: 6px;
  border-radius: 3px;
  background-color: #34d399;
}

.countdown {
  font-size: 14px;
  color: #8ee6c0;
}

.schedule {
  flex-direction: column;
  width: 176px;
  padding: 6px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.row {
  flex-direction: row;
  align-items: center;
  height: 28px;
  padding: 0 10px;
  border-radius: 14px;
}

.next {
  background-color: #0d3b2c;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-right: 8px;
}

.upcoming-dot {
  background-color: #8e8e93;
}

.next-dot {
  background-color: #34d399;
}

.past-dot {
  background-color: #3a3a3c;
}

.row-label {
  flex: 1;
  font-size: 15px;
}

.row-time {
  font-size: 15px;
}

.upcoming-text {
  color: #ffffff;
}

.next-text {
  font-weight: bold;
  color: #34d399;
}

.past-text {
  color: #636366;
}

.footer {
  font-size: 13px;
  color: #636366;
  margin-top: 8px;
}

/* Wide screens (Band 9 Pro): smaller type, and the next prayer and the
   schedule sit side by side */
.w-page {
  height: 274px;
  padding: 8px 8px 8px 8px;
}

.w-date {
  font-size: 10px;
}

.w-time {
  font-size: 40px;
}

.w-colon {
  margin: 0 1px 4px 1px;
}

.w-track {
  width: 176px;
  height: 3px;
  margin-bottom: 4px;
}

.w-seconds-fill {
  height: 3px;
}

.w-hijri {
  font-size: 10px;
  margin-bottom: 6px;
}

.w-panels {
  flex-direction: row;
  justify-content: space-between;
  width: 176px;
}

.w-hero {
  width: 78px;
  padding: 8px;
  margin-bottom: 0;
  border-radius: 14px;
}

.w-hero-row {
  flex-direction: column;
  align-items: flex-start;
}

.w-hero-label {
  font-size: 11px;
}

.w-hero-time {
  font-size: 18px;
}

.w-hero-track {
  width: 62px;
  height: 4px;
  margin: 6px 0 4px 0;
}

.w-hero-fill {
  height: 4px;
}

.w-countdown {
  font-size: 7px;
}

.w-schedule {
  width: 94px;
  padding: 4px;
  border-radius: 14px;
}

.w-row {
  height: 16px;
  padding: 0 5px;
  border-radius: 8px;
}

.w-dot {
  width: 4px;
  height: 4px;
  border-radius: 2px;
  margin-right: 4px;
}

.w-row-text {
  font-size: 9px;
}

.w-footer {
  font-size: 8px;
  margin-top: 6px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}

.r-hero {
  width: 68px;
}

.r-hero-track {
  width: 52px;
}

.r-schedule {
  width: 88px;
}
</style>
