<template>
  <scroll id="scroller" class="page {{w}}page" style="{{frame}}" scroll-y="true">
    <text class="title {{w}}title">{{title}}</text>
    <div class="items {{r}}fit">
      <div class="card {{w}}card" for="{{items}}">
        <div class="header {{w}}header">
          <div class="number {{w}}number">
            <text class="number-text {{w}}number-text">{{$item.no}}</text>
          </div>
          <text class="name {{w}}name">{{$item.name}}</text>
        </div>
        <text class="meaning {{w}}meaning">{{$item.meaning}}</text>
      </div>
    </div>

    <div class="pager {{w}}pager {{r}}fit">
      <div class="button {{page === 0 ? 'button-disabled' : ''}} {{w}}button" onclick="go(-1)">
        <text class="button-text {{w}}button-text">‹</text>
      </div>
      <text class="range {{w}}range">{{range}}</text>
      <div class="button {{page === pageCount - 1 ? 'button-disabled' : ''}} {{w}}button" onclick="go(1)">
        <text class="button-text {{w}}button-text">›</text>
      </div>
    </div>
  </scroll>
</template>

<script>
import ASMAUL_HUSNA from '../../common/asmaulhusna.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { keepScreenOn, loadLayout } from '../../common/screen.js'

// Column of the meaning in asmaulhusna.js for each language
const MEANING_COLUMN = { id: 1, en: 2, zh: 3 }
// Rendering all 99 cards at once is too heavy for the band, so show them in pages
const PER_PAGE = 11

export default {
  private: {
    w: '',
    frame: '',
    r: '',
    title: STRINGS.id.asmaulhusna,
    lang: 'id',
    page: 0,
    pageCount: Math.ceil(ASMAUL_HUSNA.length / PER_PAGE),
    range: '',
    items: []
  },

  onInit() {
    loadLayout((w, frame, r) => {
      this.w = w
      this.frame = frame
      this.r = r
    })
    this.render()
    loadLanguage((lang) => {
      this.lang = lang
      this.title = STRINGS[lang].asmaulhusna
      this.render()
    })
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  go(n) {
    const next = this.page + n
    if (next < 0 || next >= this.pageCount) return
    this.page = next
    this.render()
    // Jump back to the first name of the new page
    const scroller = this.$element('scroller')
    if (scroller && scroller.scrollTo) scroller.scrollTo({ top: 0, behavior: 'instant' })
  },

  render() {
    const start = this.page * PER_PAGE
    const end = Math.min(start + PER_PAGE, ASMAUL_HUSNA.length)
    const column = MEANING_COLUMN[this.lang]
    const items = []
    for (let i = start; i < end; i++) {
      items.push({ no: i + 1, name: ASMAUL_HUSNA[i][0], meaning: ASMAUL_HUSNA[i][column] })
    }
    this.items = items
    this.range = start + 1 + '–' + end
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
}

.items {
  flex-direction: column;
  width: 176px;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 12px 14px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

.number {
  justify-content: center;
  align-items: center;
  width: 28px;
  height: 28px;
  border-radius: 14px;
  margin-right: 8px;
  background-color: #3b1f4f;
}

.number-text {
  font-size: 13px;
  font-weight: bold;
  color: #d9a6ff;
}

.name {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
}

.meaning {
  font-size: 15px;
  color: #8e8e93;
}

.pager {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 176px;
  margin-top: 8px;
  padding: 6px;
  border-radius: 30px;
  background-color: #1c1c1e;
}

.button {
  justify-content: center;
  align-items: center;
  width: 48px;
  height: 48px;
  border-radius: 24px;
  background-color: #3b1f4f;
}

.button-disabled {
  background-color: #2c2c2e;
}

.button-text {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}

.range {
  font-size: 16px;
  color: #ffffff;
}

/* Wide screens (Band 9 Pro): the band layout at about 0.6x, since px
   there is scaled 1.75x */
.w-page {
  height: 274px;
  padding: 22px 5px 14px 5px;
}

.w-title {
  font-size: 13px;
  margin-bottom: 10px;
}

.w-card {
  padding: 7px 8px;
  margin-bottom: 5px;
  border-radius: 13px;
}

.w-header {
  margin-bottom: 2px;
}

.w-number {
  width: 17px;
  height: 17px;
  border-radius: 8px;
  margin-right: 5px;
}

.w-number-text {
  font-size: 8px;
}

.w-name {
  font-size: 11px;
}

.w-meaning {
  font-size: 9px;
}

.w-pager {
  margin-top: 5px;
  padding: 4px;
  border-radius: 18px;
}

.w-button {
  width: 29px;
  height: 29px;
  border-radius: 14px;
}

.w-button-text {
  font-size: 16px;
}

.w-range {
  font-size: 10px;
}

/* Round watches: full-width blocks narrow to what the circle shows */
.r-fit {
  width: 160px;
}
</style>
