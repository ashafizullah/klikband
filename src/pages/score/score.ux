<template>
  <div class="page">
    <!-- Tap to change the mode; locked once the match has started -->
    <div class="mode" onclick="nextMode">
      <text class="mode-text" style="color: {{canChangeMode ? '#ffffff' : '#636366'}};">{{modeName}}</text>
    </div>

    <!-- The middle section fills the remaining height, so the buttons stay put -->
    <div class="middle">
      <div class="side side-a" onclick="add('a')">
        <text class="points">{{aPoints}}</text>
        <text if="{{aDetail}}" class="detail" style="color: {{winner === 'a' ? '#30d158' : '#8ab4ff'}};">{{aDetail}}</text>
      </div>
      <div class="side side-b" onclick="add('b')">
        <text class="points">{{bPoints}}</text>
        <text if="{{bDetail}}" class="detail" style="color: {{winner === 'b' ? '#30d158' : '#ff9a94'}};">{{bDetail}}</text>
      </div>
    </div>

    <!-- One full-width button per row, easier to tap on the band -->
    <div class="button" onclick="undo">
      <text class="button-text" style="color: {{canUndo ? '#ffffff' : '#636366'}};">{{t.undo}}</text>
    </div>
    <!-- Inline colors: a changing class here broke the button size on the band -->
    <div class="button" style="background-color: {{confirming ? '#ff453a' : '#1c1c1e'}};" onclick="reset">
      <text class="button-text">{{confirming ? t.sure : t.reset}}</text>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import storage from '@system.storage'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { MODES, newMatch, addPoint, pointsText, detailText } from '../../common/score.js'
import { keepScreenOn } from '../../common/screen.js'

// Match states kept for undo
const MAX_HISTORY = 50
// Reset needs a second tap within this time
const CONFIRM_MS = 3000

export default {
  private: {
    t: STRINGS.id,
    modeName: '',
    aPoints: '0',
    bPoints: '0',
    aDetail: '',
    bDetail: '',
    winner: '',
    canUndo: false,
    canChangeMode: true,
    confirming: false
  },

  onInit() {
    this.match = newMatch('points')
    this.history = []
    this.render()
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.render()
    })
    storage.get({
      key: 'score',
      success: (data) => {
        if (!data) return
        try {
          const s = JSON.parse(data)
          // Scores saved by 1.8.0 were { a, b, history }
          if (s.match) {
            this.match = s.match
            this.history = s.history || []
            // Test builds of 1.9.0 had no `past`
            if (!this.match.past) {
              this.match.past = []
              this.history = []
            }
          } else {
            this.match = newMatch('points')
            this.match.a.p = s.a || 0
            this.match.b.p = s.b || 0
          }
          this.render()
        } catch (e) {}
      }
    })
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  onDestroy() {
    clearTimeout(this.confirmTimer)
  },

  render() {
    const t = this.t
    const m = this.match
    this.modeName = t.scoreModes[m.mode]
    this.aPoints = pointsText(m, 'a')
    this.bPoints = pointsText(m, 'b')
    this.aDetail = detailText(m, 'a', t)
    this.bDetail = detailText(m, 'b', t)
    this.winner = m.winner
    this.canUndo = this.history.length > 0
    this.canChangeMode = JSON.stringify(m) === JSON.stringify(newMatch(m.mode))
  },

  save() {
    this.render()
    storage.set({
      key: 'score',
      value: JSON.stringify({ match: this.match, history: this.history })
    })
  },

  add(side) {
    if (this.match.winner) return
    this.history.push(this.match)
    if (this.history.length > MAX_HISTORY) this.history.shift()
    const result = addPoint(this.match, side)
    this.match = result.state
    vibrator.vibrate({ mode: result.event === 'point' ? 'short' : 'long' })
    this.save()
  },

  undo() {
    if (!this.history.length) return
    this.match = this.history.pop()
    this.save()
  },

  nextMode() {
    if (!this.canChangeMode) return
    const i = MODES.indexOf(this.match.mode)
    this.match = newMatch(MODES[(i + 1) % MODES.length])
    this.history = []
    this.save()
  },

  reset() {
    if (!this.confirming) {
      this.confirming = true
      this.confirmTimer = setTimeout(() => (this.confirming = false), CONFIRM_MS)
      return
    }
    clearTimeout(this.confirmTimer)
    this.confirming = false
    this.match = newMatch(this.match.mode)
    this.history = []
    vibrator.vibrate({ mode: 'long' })
    this.save()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.mode {
  justify-content: center;
  align-items: center;
  width: 140px;
  height: 36px;
  flex-shrink: 0;
  border-radius: 18px;
  background-color: #1c1c1e;
}

.mode-text {
  width: 140px;
  text-align: center;
  font-size: 17px;
  font-weight: bold;
}

.middle {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 176px;
}

.side {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 176px;
  height: 128px;
  flex-shrink: 0;
  margin: 4px 0;
  border-radius: 26px;
  border-width: 4px;
}

.side-a {
  border-color: #3d7bff;
  background-color: #10203f;
}

.side-b {
  border-color: #ff453a;
  background-color: #3f1210;
}

.points {
  font-size: 64px;
  font-weight: bold;
  color: #ffffff;
}

.detail {
  font-size: 15px;
  font-weight: bold;
}

.button {
  justify-content: center;
  align-items: center;
  width: 176px;
  height: 48px;
  flex-shrink: 0;
  margin-top: 8px;
  border-radius: 24px;
  background-color: #1c1c1e;
}

.button-text {
  width: 176px;
  text-align: center;
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
}
</style>
