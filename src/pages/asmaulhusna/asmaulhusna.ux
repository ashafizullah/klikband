<template>
  <scroll id="scroller" class="page" scroll-y="true">
    <text class="title">{{title}}</text>
    <div class="items">
      <div class="card" for="{{items}}">
        <div class="header">
          <div class="number">
            <text class="number-text">{{$item.no}}</text>
          </div>
          <text class="name">{{$item.name}}</text>
        </div>
        <text class="meaning">{{$item.meaning}}</text>
      </div>
    </div>

    <div class="pager">
      <div class="button {{page === 0 ? 'button-disabled' : ''}}" onclick="go(-1)">
        <text class="button-text">‹</text>
      </div>
      <text class="range">{{range}}</text>
      <div class="button {{page === pageCount - 1 ? 'button-disabled' : ''}}" onclick="go(1)">
        <text class="button-text">›</text>
      </div>
    </div>
  </scroll>
</template>

<script>
import ASMAUL_HUSNA from '../../common/asmaulhusna.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'
import { keepScreenOn } from '../../common/screen.js'

// Column of the meaning in asmaulhusna.js for each language
const MEANING_COLUMN = { id: 1, en: 2, zh: 3 }
// Rendering all 99 cards at once is too heavy for the band, so show them in pages
const PER_PAGE = 11

export default {
  private: {
    title: STRINGS.id.asmaulhusna,
    lang: 'id',
    page: 0,
    pageCount: Math.ceil(ASMAUL_HUSNA.length / PER_PAGE),
    range: '',
    items: []
  },

  onInit() {
    this.render()
    loadLanguage((lang) => {
      this.lang = lang
      this.title = STRINGS[lang].asmaulhusna
      this.render()
    })
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  go(n) {
    const next = this.page + n
    if (next < 0 || next >= this.pageCount) return
    this.page = next
    this.render()
    // Jump back to the first name of the new page
    const scroller = this.$element('scroller')
    if (scroller && scroller.scrollTo) scroller.scrollTo({ top: 0, behavior: 'instant' })
  },

  render() {
    const start = this.page * PER_PAGE
    const end = Math.min(start + PER_PAGE, ASMAUL_HUSNA.length)
    const column = MEANING_COLUMN[this.lang]
    const items = []
    for (let i = start; i < end; i++) {
      items.push({ no: i + 1, name: ASMAUL_HUSNA[i][0], meaning: ASMAUL_HUSNA[i][column] })
    }
    this.items = items
    this.range = start + 1 + '–' + end
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16px;
}

.items {
  flex-direction: column;
  width: 176px;
}

.card {
  flex-direction: column;
  width: 176px;
  padding: 12px 14px;
  margin-bottom: 8px;
  border-radius: 22px;
  background-color: #1c1c1e;
}

.header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

.number {
  justify-content: center;
  align-items: center;
  width: 28px;
  height: 28px;
  border-radius: 14px;
  margin-right: 8px;
  background-color: #3b1f4f;
}

.number-text {
  font-size: 13px;
  font-weight: bold;
  color: #d9a6ff;
}

.name {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
}

.meaning {
  font-size: 15px;
  color: #8e8e93;
}

.pager {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 176px;
  margin-top: 8px;
  padding: 6px;
  border-radius: 30px;
  background-color: #1c1c1e;
}

.button {
  justify-content: center;
  align-items: center;
  width: 48px;
  height: 48px;
  border-radius: 24px;
  background-color: #3b1f4f;
}

.button-disabled {
  background-color: #2c2c2e;
}

.button-text {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}

.range {
  font-size: 16px;
  color: #ffffff;
}
</style>
