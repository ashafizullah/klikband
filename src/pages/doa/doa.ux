<template>
  <scroll class="page" scroll-y="true">
    <text class="judul">{{judul}}</text>
    <div class="kartu" for="{{daftar}}">
      <text class="nama">{{item.judul[bahasa]}}</text>
      <text class="latin">{{item.latin}}</text>
      <text class="arti">{{item.arti[bahasa]}}</text>
    </div>
  </scroll>
</template>

<script>
import DOA from '../../common/doa.js'
import { TEKS, muatBahasa } from '../../common/i18n.js'

export default {
  private: {
    daftar: DOA,
    judul: TEKS.id.doa,
    bahasa: 'id'
  },

  onInit() {
    muatBahasa((kode) => {
      this.judul = TEKS[kode].doa
      this.bahasa = kode
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 24px 12px;
  background-color: #000000;
}

.judul {
  font-size: 22px;
  color: #7ee2b8;
  margin-bottom: 16px;
}

.kartu {
  flex-direction: column;
  width: 168px;
  padding: 12px;
  margin-bottom: 10px;
  border-radius: 14px;
  background-color: #1a1a1a;
}

.nama {
  font-size: 18px;
  color: #7ee2b8;
  margin-bottom: 6px;
}

.latin {
  font-size: 18px;
  color: #ffffff;
  margin-bottom: 6px;
}

.arti {
  font-size: 15px;
  color: #aaaaaa;
}
</style>
