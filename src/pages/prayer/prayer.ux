<template>
  <scroll class="page {{w}}page" scroll-y="true">
    <text class="title {{w}}title">{{title}}</text>
    <text class="subtitle {{w}}subtitle">{{location}}</text>
    <text class="subtitle subtitle-last {{w}}subtitle {{w}}subtitle-last">{{dateText}}</text>

    <div class="panels {{w}}panels">
      <div class="hero {{w}}hero">
        <text class="hero-label {{w}}hero-label">{{nextLabel}}</text>
        <text class="hero-time {{w}}hero-time">{{nextTime}}</text>
        <div class="pill {{w}}pill">
          <text class="pill-text {{w}}pill-text">{{countdown}}</text>
        </div>
      </div>

      <div class="list {{w}}list">
        <div class="row {{w}}row {{$item.next ? 'row-next' : ''}}" for="{{rows}}">
          <text class="name {{w}}cell {{$item.style}}">{{$item.label}}</text>
          <text class="time {{w}}cell {{$item.style}}">{{$item.time}}</text>
        </div>
      </div>
    </div>
  </scroll>
</template>

<script>
import { PRAYER_ORDER, nextPrayer, prayerDate, formatMinutes } from '../../common/prayer.js'
import { prayerAlert } from '../../common/alert.js'
import { STRINGS, loadLanguage, formatDate, formatDuration } from '../../common/i18n.js'
import { CITIES, TIME_ZONES, loadCity } from '../../common/cities.js'
import { keepScreenOn, loadLayout } from '../../common/screen.js'

export default {
  private: {
    w: '',
    title: '',
    location: '',
    dateText: '',
    nextLabel: '',
    nextTime: '',
    countdown: '',
    rows: []
  },

  onInit() {
    this.t = STRINGS.id
    this.city = CITIES[0]
    this.refresh()
    loadLayout((w) => (this.w = w))
    loadLanguage((lang) => {
      this.t = STRINGS[lang]
      this.refresh()
    })
    loadCity((city) => {
      this.city = city
      this.refresh()
    })
    // The countdown ticks every second; the rest only changes at the next prayer
    this.timer = setInterval(() => this.tick(), 1000)
  },

  onShow() {
    keepScreenOn(true)
  },

  onHide() {
    keepScreenOn(false)
  },

  onDestroy() {
    clearInterval(this.timer)
  },

  tick() {
    const seconds = Math.ceil((this.target - Date.now()) / 1000)
    // Full refresh at the next prayer, and once a minute for the date
    this.ticks = (this.ticks || 0) + 1
    if (seconds <= 0) prayerAlert(this.t, this.nextKey)
    if (seconds <= 0 || this.ticks % 60 === 0) this.refresh()
    else this.countdown = formatDuration(this.t, seconds)
  },

  refresh() {
    const t = this.t
    // After Isha this is tomorrow's schedule, so the card and the list match
    const { key: next, day, times, nowMinutes, tomorrow } = nextPrayer(new Date(), this.city)

    this.title = t.prayer
    this.location = this.city.name + ' · ' + TIME_ZONES[this.city.tz]
    this.dateText = formatDate(t, day)
    this.nextKey = next
    this.nextLabel = t.prayers[next]
    this.nextTime = formatMinutes(times[next])
    this.target = prayerDate(day, times[next]).getTime()
    this.tick()
    this.rows = PRAYER_ORDER.map((k) => ({
      label: t.prayers[k],
      time: formatMinutes(times[k]),
      next: k === next,
      // Past times are dimmed, the next one is highlighted
      style: k === next ? 'text-next' : !tomorrow && times[k] <= nowMinutes ? 'text-past' : ''
    }))
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 36px 8px 24px 8px;
  background-color: #000000;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}

.subtitle {
  font-size: 15px;
  color: #8e8e93;
  margin-top: 2px;
}

