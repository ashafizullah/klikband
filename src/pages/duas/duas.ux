<template>
  <scroll class="page" scroll-y="true">
    <text class="title">{{title}}</text>
    <div class="card" for="{{items}}">
      <text class="name">{{$item.title[lang]}}</text>
      <text class="latin">{{$item.latin}}</text>
      <div class="divider"></div>
      <text class="meaning">{{$item.meaning[lang]}}</text>
    </div>
  </scroll>
</template>

<script>
import DUAS from '../../common/duas.js'
import { STRINGS, loadLanguage } from '../../common/i18n.js'

export default {
  private: {
    items: DUAS,
    title: STRINGS.id.duas,
    lang: 'id'
  },

  onInit() {
    loadLanguage((lang) => {
      this.title = STRINGS[lang].duas
      this.lang = lang
    })
  }
}
</script>

