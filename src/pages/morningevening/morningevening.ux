<template>
  <div class="page">
    <text class="title">{{t.morningevening}}</text>
    <div class="card {{suggested === 'morning' ? 'card-suggested' : ''}}" onclick="openSet('morning')">
      <div class="icon icon-morning">
        <image class="icon-image" src="/common/icons/today.png"></image>
      </div>
      <div class="text">
        <text class="label">{{t.morning}}</text>
        <text class="time">{{t.morningTime}}</text>
      </div>
    </div>
    <div class="card {{suggested === 'evening' ? 'card-suggested' : ''}}" onclick="openSet('evening')">
      <div class="icon icon-evening">
        <image class="icon-image" src="/common/icons/islam.png"></image>
      </div>
      <div class="text">
        <text class="label">{{t.evening}}</text>
        <text class="time">{{t.eveningTime}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { STRINGS, loadLanguage } from '../../common/i18n.js'

export default {
  private: {
    t: STRINGS.id,
    // Highlight evening from noon onwards, morning otherwise
    suggested: new Date().getHours() >= 12 ? 'evening' : 'morning'
  },

  onInit() {
    loadLanguage((lang) => (this.t = STRINGS[lang]))
  },

  openSet(set) {
    router.push({ uri: '/pages/dhikr', params: { set } })
  }
}
</script>

