<template>
  <scroll class="page" scroll-y="true">
    <text class="judul">{{judul}}</text>
    <div class="kartu" for="{{daftar}}">
      <text class="nomor">{{$idx + 1}}</text>
      <text class="nama">{{item[0]}}</text>
      <text class="arti">{{item[kolom]}}</text>
    </div>
  </scroll>
</template>

<script>
import ASMAUL from '../../common/asmaul.js'
import { TEKS, muatBahasa } from '../../common/i18n.js'

// Kolom arti di asmaul.js per bahasa
const KOLOM = { id: 1, en: 2, zh: 3 }

export default {
  private: {
    daftar: ASMAUL,
    judul: TEKS.id.asmaul,
    kolom: 1
  },

  onInit() {
    muatBahasa((kode) => {
      this.judul = TEKS[kode].asmaul
      this.kolom = KOLOM[kode]
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 192px;
  height: 490px;
  padding: 24px 12px;
  background-color: #000000;
}

.judul {
  font-size: 22px;
  color: #7ee2b8;
  margin-bottom: 16px;
}

.kartu {
  flex-direction: column;
  width: 168px;
  padding: 10px 12px;
  margin-bottom: 8px;
  border-radius: 14px;
  background-color: #1a1a1a;
}

.nomor {
  font-size: 14px;
  color: #7ee2b8;
}

.nama {
  font-size: 20px;
  color: #ffffff;
}

.arti {
  font-size: 16px;
  color: #aaaaaa;
}
</style>
