}

.w-tile-month {
  width: 78px;
  font-size: 9px;
}

.w-hero {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8px 10px;
  margin-bottom: 6px;
  border-radius: 14px;
}

.w-hero-main {
  align-items: flex-start;
}

.w-hero-label {
